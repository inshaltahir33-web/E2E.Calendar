<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource App.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource App.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="MinHeight" Value="{StaticResource ChipMinHeight}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style x:Key="EventChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource App.HoverBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
        <Setter Property="MinHeight" Value="{StaticResource ChipMinHeight}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionHeader}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="SubtleHoverStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="{StaticResource InsetSM}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Rest">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Hover">
                                    <VisualState.Setters>
                                        <Setter Target="HoverVeil.Opacity" Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverVeil.Opacity" Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource App.SelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource App.SelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focus">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource App.FocusBrush}" />
                                        <Setter Target="Root.BorderThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource App.FocusBrush}" />
                                        <Setter Target="Root.BorderThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border
                                x:Name="HoverVeil"
                                Background="{ThemeResource App.HoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarRowStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Height" Value="{StaticResource SidebarRowHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="AccentBar"
                            Width="{StaticResource AccentBarWidth}"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource App.AccentBrush}"
                            CornerRadius="{StaticResource RadiusControl}"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Rest">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                    <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                    <VisualState x:Name="Hover">
                                        <VisualState.Setters>
                                            <Setter Target="HoverVeil.Opacity" Value="1" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverVeil"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="{StaticResource TransitionDuration}" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverVeil.Opacity" Value="1" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverVeil"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="{StaticResource TransitionDuration}" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource App.SelectedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource App.SelectedBrush}" />
                                            <Setter Target="AccentBar.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focus">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource App.FocusBrush}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource App.FocusBrush}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border
                                    x:Name="HoverVeil"
                                    Background="{ThemeResource App.HoverBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Rest">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Hover">
                                    <VisualState.Setters>
                                        <Setter Target="HoverVeil.Opacity" Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverVeil.Opacity" Value="1" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource TransitionDuration}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource App.SelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource App.SelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focus">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource App.FocusBrush}" />
                                        <Setter Target="Root.BorderThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource App.FocusBrush}" />
                                        <Setter Target="Root.BorderThickness" Value="2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border
                                x:Name="HoverVeil"
                                Background="{ThemeResource App.HoverBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource App.CardElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <!-- 16px inset so section labels keep a clean left margin and never clip. -->
        <Setter Property="Padding" Value="{StaticResource SpaceLG}" />
    </Style>

    <Style x:Key="EditorCardHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource App.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <!-- 16px inset keeps title / description / control comfortably apart. -->
        <Setter Property="Padding" Value="{StaticResource InsetLG}" />
    </Style>

    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextPrimaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="SettingsCardDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <!-- Shared styles required by UI-SPEC -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource App.AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource App.OnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AccentButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button" />

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource App.SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionHeader}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource App.TextSecondaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="ViewSwitcherStyle" TargetType="muxc:SelectorBar">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{ThemeResource App.SurfaceRaisedBrush}" />
    </Style>
    <Style x:Key="SegmentedViewSwitcherStyle" BasedOn="{StaticResource ViewSwitcherStyle}" TargetType="muxc:SelectorBar" />

    <!-- Flyouts and menus: 8px radius, Surface background, 1px border, small shadow. -->
    <Style x:Key="AppFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="{StaticResource InsetMD}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="{StaticResource InsetXS}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="AppToggleMenuFlyoutItemStyle" TargetType="ToggleMenuFlyoutItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

</ResourceDictionary>
