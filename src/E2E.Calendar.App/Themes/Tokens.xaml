    <x:Double x:Key="Space.L">16</x:Double><x:Double x:Key="Space.XL">24</x:Double>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius><CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">6</CornerRadius><CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <x:Double x:Key="Sidebar.Width">272</x:Double><x:Double x:Key="Grid.HourHeight">56</x:Double>
    <x:Double x:Key="Grid.GutterWidth">56</x:Double><x:Double x:Key="Grid.DayHeaderHeight">64</x:Double>

