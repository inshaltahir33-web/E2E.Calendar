    <!-- E2E Calendar theme tokens. Brand: Ink Indigo. Do NOT hard-code colours anywhere else. -->

    <!-- Brand accent overrides system accent so stock controls (toggles, checkboxes, accent buttons) match -->
    <Color x:Key="SystemAccentColor">#4F5BD5</Color>
    <Color x:Key="SystemAccentColorLight1">#6C77E0</Color>
    <Color x:Key="SystemAccentColorLight2">#8B95FF</Color>
    <Color x:Key="SystemAccentColorLight3">#B3B9FF</Color>
    <Color x:Key="SystemAccentColorDark1">#444FC0</Color>
    <Color x:Key="SystemAccentColorDark2">#3A44A8</Color>
    <Color x:Key="SystemAccentColorDark3">#2E3786</Color>

    <!-- Spacing / radius / size -->
