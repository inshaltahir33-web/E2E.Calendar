<UserControl
    x:Class="E2E.Calendar.App.Controls.TimeGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootLayout"
        KeyDown="OnGridKeyDown"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- Row 0: weather chip, top-right of the header. Row 1: day headers. Rows 2-4: all-day
             strip. Row 5: scrollable body. Header, all-day strip and body share one set of
             column definitions so they can never drift out of alignment. -->

        <Border
            x:Name="WeatherChip"
            Grid.Row="0"
            Margin="0,4,8,2"
            Padding="8,2,10,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{ThemeResource App.CardElevatedBrush}"
            BorderBrush="{ThemeResource App.DividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusPill}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSS}">
                <FontIcon
                    x:Name="WeatherIcon"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource IconSizeMedium}"
                    Foreground="{ThemeResource App.TextSecondaryBrush}"
                    Glyph="&#xE753;" />
                <TextBlock
                    x:Name="WeatherTemperatureText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource App.TextPrimaryBrush}" />
                <TextBlock
                    x:Name="WeatherConditionText"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource App.TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer
            x:Name="BodyScroll"
            Grid.Row="5"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Enabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="OnBodyScrollSizeChanged"
            ViewChanged="OnViewChanged">

            <Grid
                x:Name="BodyGrid"
                Background="{ThemeResource App.SurfaceBaseBrush}">
                <Canvas x:Name="GutterCanvas" Grid.Column="0" />
                <Canvas
                    x:Name="OverlayCanvas"
                    Grid.Column="0"
                    IsHitTestVisible="False" />
            </Grid>

        </ScrollViewer>

        <Border
            x:Name="ScrollIndicator"
            Grid.Row="5"
            Width="4"
            Margin="0,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{ThemeResource ScrollBarThumbBackground}"
            CornerRadius="2"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!-- Empty state: small icon + title + one hint line, parked in the top third of the
             grid so it never lands on top of the now line. -->
        <StackPanel
            x:Name="EmptyHint"
            Grid.Row="5"
            MaxWidth="{StaticResource EmptyStateMaxWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="{StaticResource SpaceXXS}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeSubtitle}"
                Foreground="{ThemeResource App.TextTertiaryBrush}"
                Glyph="&#xE787;" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource App.TextPrimaryBrush}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="Nothing scheduled" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource App.TextSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Double-click a time slot or press N to add an event."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

    </Grid>

</UserControl>
