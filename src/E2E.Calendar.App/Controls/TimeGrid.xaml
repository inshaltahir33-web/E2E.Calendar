<UserControl
    x:Class="E2E.Calendar.App.Controls.TimeGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootLayout"
        KeyDown="OnGridKeyDown"
        RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Row 0: day headers. Row 1-3: all-day strip. Row 4: scrollable body.
             Header, all-day strip and body share the same column definitions. -->

        <ScrollViewer
            x:Name="BodyScroll"
            Grid.Row="4"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Enabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="OnBodyScrollSizeChanged"
            ViewChanged="OnViewChanged">

            <Grid x:Name="BodyGrid">
                <Canvas x:Name="GutterCanvas" Grid.Column="0" />
                <Canvas
                    x:Name="OverlayCanvas"
                    Grid.Column="0"
                    IsHitTestVisible="False" />
            </Grid>

        </ScrollViewer>

        <Border
            x:Name="ScrollIndicator"
            Grid.Row="4"
            Width="4"
            Margin="0,2,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{ThemeResource ScrollBarThumbBackground}"
            CornerRadius="2"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <Border
            x:Name="EmptyHint"
            Grid.Row="4"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource App.CardBackgroundBrush}"
            BorderBrush="{ThemeResource App.DividerBrush}"
            BorderThickness="1"
            CornerRadius="16"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                Foreground="{ThemeResource App.TextSecondaryBrush}"
                FontSize="12"
                Text="Nothing scheduled. Double-click or press N." />
        </Border>

    </Grid>

</UserControl>
