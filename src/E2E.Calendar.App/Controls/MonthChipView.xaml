<UserControl
    x:Class="E2E.Calendar.App.Controls.MonthChipView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="ChipBorder"
        Height="20"
        Padding="0,0,4,0"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusChip}">
        <Grid>
            <Grid ColumnDefinitions="3,*">
                <Border x:Name="AccentEdge" Background="Transparent" />
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border
                x:Name="HoverFill"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="3"
                Visibility="Collapsed" />

            <Border
                x:Name="FocusRing"
                BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}"
                BorderThickness="{StaticResource FocusStrokeThickness}"
                CornerRadius="4"
                Visibility="Collapsed" />
        </Grid>
    </Border>

</UserControl>
