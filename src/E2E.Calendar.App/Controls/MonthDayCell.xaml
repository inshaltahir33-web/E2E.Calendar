<UserControl
    x:Class="E2E.Calendar.App.Controls.MonthDayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Border
        x:Name="CellBorder"
        MinHeight="{StaticResource MonthCellMinHeight}"
        BorderBrush="{ThemeResource GridLine}"
        BorderThickness="0,0,1,1">
        <Grid
            x:Name="CellRoot"
            Background="{ThemeResource App.TransparentBrush}"
            IsTabStop="True"
            KeyDown="OnCellKeyDown">

        <Border
            x:Name="WeekendTint"
            Background="{ThemeResource App.WeekendTintBrush}"
            Opacity="0.6" />

        <Border
            x:Name="HoverFill"
            Background="{ThemeResource App.HoverBrush}"
            CornerRadius="{StaticResource RadiusSwatch}"
            Visibility="Collapsed" />

        <!-- Selected day is a 1px Accent border only: no fill, no strip. -->
        <Border
            x:Name="SelectionBorder"
            BorderBrush="{ThemeResource Accent}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSwatch}"
            Visibility="Collapsed" />

        <Border
            x:Name="FocusRing"
            BorderBrush="{ThemeResource App.FocusBrush}"
            BorderThickness="{StaticResource FocusStrokeThickness}"
            CornerRadius="{StaticResource RadiusSwatch}"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="CellContent"
            Padding="2">

            <Grid Height="20" HorizontalAlignment="Left">
                <Ellipse
                    x:Name="TodayCircle"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource Accent}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="DayText"
                    Width="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{ThemeResource TextPrimary}" />
                <TextBlock
                    x:Name="TodayText"
                    Width="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{ThemeResource App.OnAccentBrush}"
                    Visibility="Collapsed" />
            </Grid>

            <StackPanel x:Name="ChipsHost" Spacing="1" />

            <!-- "+N more" is a small link on the last line, not a button-looking pill. -->
            <Button
                x:Name="MoreButton"
                AutomationProperties.Name="Show the remaining events for this day"
                Height="16"
                MinHeight="0"
                Margin="0,1,0,0"
                HorizontalAlignment="Left"
                Background="{ThemeResource App.TransparentBrush}"
                BorderThickness="0"
                Padding="2,0"
                Click="OnMoreClick"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="MoreText"
                    FontSize="{StaticResource FontSizeChip}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource App.TextSecondaryBrush}" />
            </Button>

        </StackPanel>

        </Grid>
    </Border>

</UserControl>
