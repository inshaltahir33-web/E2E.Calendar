<UserControl
    x:Class="E2E.Calendar.App.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="{StaticResource InsetLG}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource App.CardBackgroundBrush}"
        BorderBrush="{ThemeResource App.DividerBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusCard}">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource SpaceSM}"
            MaxWidth="320">

            <FontIcon
                x:Name="GlyphIcon"
                HorizontalAlignment="Center"
                FontSize="28"
                Foreground="{ThemeResource App.TextSecondaryBrush}" />

            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="DescriptionText"
                HorizontalAlignment="Center"
                Opacity="{StaticResource TextSecondaryOpacity}"
                Style="{ThemeResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                x:Name="ActionButton"
                AutomationProperties.Name="Perform the suggested action"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Click="OnActionClick"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />

        </StackPanel>

    </Border>

</UserControl>
