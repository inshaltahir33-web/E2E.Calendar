<UserControl
    x:Class="E2E.Calendar.App.Controls.MiniCalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Horizontal pointer drags page the month. The pointer is only captured once a
         drag passes the slop threshold, so taps still select a day and vertical drags
         still scroll the sidebar. -->
    <StackPanel
        Margin="10,4,10,4"
        Spacing="{StaticResource SpaceXXS}"
        KeyDown="OnCalendarKeyDown"
        PointerWheelChanged="OnCalendarPointerWheelChanged"
        PointerPressed="OnCalendarPointerPressed"
        PointerMoved="OnCalendarPointerMoved"
        PointerReleased="OnCalendarPointerReleased"
        PointerCanceled="OnCalendarPointerCanceled"
        PointerCaptureLost="OnCalendarPointerCaptureLost">

        <Grid Height="26" ColumnDefinitions="Auto,*,Auto">
            <Button
                x:Name="PreviousMonthButton"
                Click="OnPreviousMonthClick"
                Style="{StaticResource ToolbarButtonStyle}"
                Width="26"
                Height="26"
                Padding="0"
                AutomationProperties.Name="Previous month"
                ToolTipService.ToolTip="Previous month">
                <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE72B;" />
            </Button>

            <Button
                x:Name="HeaderText"
                Grid.Column="1"
                Padding="8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="OnHeaderClick"
                Content="{x:Bind ViewModel.HeaderText, Mode=OneWay}"
                FontSize="{StaticResource FontSizeBodyStrong}"
                FontWeight="SemiBold"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Choose month and year"
                ToolTipService.ToolTip="Choose month and year" />

            <Button
                x:Name="NextMonthButton"
                Grid.Column="2"
                Click="OnNextMonthClick"
                Style="{StaticResource ToolbarButtonStyle}"
                Width="26"
                Height="26"
                Padding="0"
                AutomationProperties.Name="Next month"
                ToolTipService.ToolTip="Next month">
                <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE72A;" />
            </Button>
        </Grid>

        <Border x:Name="CalendarClipper"
                HorizontalAlignment="Center"
                Margin="0,4"
                PointerPressed="OnCalendarPointerPressed"
                PointerMoved="OnCalendarPointerMoved"
                PointerReleased="OnCalendarPointerReleased"
                PointerCanceled="OnCalendarPointerCanceled"
                PointerCaptureLost="OnCalendarPointerCaptureLost">
            <Border.Clip>
                <RectangleGeometry
                    x:Name="ClipGeometry"
                    Rect="0,0,252,252" />
            </Border.Clip>
            <Grid>
                <Grid x:Name="CalendarGrid"
                      HorizontalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CalendarTransform" />
                    </Grid.RenderTransform>
                </Grid>
            </Grid>
        </Border>

    </StackPanel>

</UserControl>
