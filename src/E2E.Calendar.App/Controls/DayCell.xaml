<UserControl
    x:Class="E2E.Calendar.App.Controls.DayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Width="36"
        Height="36"
        Background="Transparent">

        <Border
            x:Name="WeekBackground"
            Background="{ThemeResource App.HoverBrush}"
            CornerRadius="{StaticResource RadiusControl}"
            Visibility="Collapsed" />

        <Border
            x:Name="HoverFill"
            Background="{ThemeResource App.HoverBrush}"
            CornerRadius="{StaticResource RadiusControl}"
            Opacity="0.6"
            Visibility="Collapsed" />

        <Ellipse
            x:Name="TodayCircle"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{ThemeResource App.AccentBrush}"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="DayText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,6"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{ThemeResource App.TextPrimaryBrush}" />

        <TextBlock
            x:Name="TodayText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,6"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{ThemeResource App.OnAccentBrush}"
            Visibility="Collapsed" />

        <Ellipse
            x:Name="EventDot"
            Width="4"
            Height="4"
            Margin="0,0,0,3"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Fill="{ThemeResource App.AccentBrush}"
            Visibility="Collapsed" />

        <Border
            x:Name="FocusRing"
            BorderBrush="{ThemeResource App.FocusBrush}"
            BorderThickness="{StaticResource FocusStrokeThickness}"
            CornerRadius="{StaticResource RadiusControl}"
            Visibility="Collapsed" />

    </Grid>

</UserControl>
