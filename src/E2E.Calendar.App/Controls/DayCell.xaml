<UserControl
    x:Class="E2E.Calendar.App.Controls.DayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UI-SPEC: 28px mini-calendar cells. No dark "selected week" strip; the row is
         only tinted with AccentSoft while hovered. Today = Accent filled circle,
         selected day = 1px Accent border, days with events show a small dot. -->
    <Grid
        Width="28"
        Height="28"
        Background="{ThemeResource App.TransparentBrush}">

        <Border
            x:Name="HoverFill"
            Background="{ThemeResource AccentSoft}"
            CornerRadius="{StaticResource RadiusPill}"
            Visibility="Collapsed" />

        <Border
            x:Name="SelectedRing"
            BorderBrush="{ThemeResource Accent}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusPill}"
            Visibility="Collapsed" />

        <Ellipse
            x:Name="TodayCircle"
            Width="22"
            Height="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{ThemeResource Accent}"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="DayText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,2"
            FontSize="{StaticResource FontSizeSectionHeader}"
            Foreground="{ThemeResource TextPrimary}" />

        <TextBlock
            x:Name="TodayText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,2"
            FontSize="{StaticResource FontSizeSectionHeader}"
            Foreground="{ThemeResource App.OnAccentBrush}"
            Visibility="Collapsed" />

        <Ellipse
            x:Name="EventDot"
            Width="3"
            Height="3"
            Margin="0,0,0,2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Fill="{ThemeResource Accent}"
            Visibility="Collapsed" />

        <Border
            x:Name="FocusRing"
            BorderBrush="{ThemeResource App.FocusBrush}"
            BorderThickness="{StaticResource FocusStrokeThickness}"
            CornerRadius="{StaticResource RadiusPill}"
            Visibility="Collapsed" />

    </Grid>

</UserControl>
