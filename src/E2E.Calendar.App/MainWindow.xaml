<Window
    x:Class="E2E.Calendar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:muxcp="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:views="using:E2E.Calendar.App.Views"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource App.WindowBackgroundBrush}"
       
        RowDefinitions="Auto,*">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Invoked="OnNewAccelerator"/>
            <KeyboardAccelerator Key="R" Invoked="OnNewReminderAccelerator"/>
            <KeyboardAccelerator Key="T" Invoked="OnTodayAccelerator"/>
            <KeyboardAccelerator Key="D" Invoked="OnDayViewAccelerator"/>
            <KeyboardAccelerator Key="W" Invoked="OnWeekViewAccelerator"/>
            <KeyboardAccelerator Key="M" Invoked="OnMonthViewAccelerator"/>
            <KeyboardAccelerator Key="A" Invoked="OnAgendaViewAccelerator"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteAccelerator"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator"/>
            <KeyboardAccelerator Key="Left" Invoked="OnPreviousAccelerator"/>
            <KeyboardAccelerator Key="Right" Invoked="OnNextAccelerator"/>
            <KeyboardAccelerator Key="Up" Invoked="OnPreviousAccelerator"/>
            <KeyboardAccelerator Key="Down" Invoked="OnNextAccelerator"/>
        </Grid.KeyboardAccelerators>

        <Grid
            x:Name="TitleBarElement"
            Grid.Row="0"
            Height="{StaticResource TitleBarHeight}"
            Padding="{StaticResource PaddingTitleBar}"
            Background="Transparent"
            ColumnDefinitions="Auto,Auto,Auto,Auto">

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="0"
                Click="OnPaneToggleClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Toggle the navigation pane"
                ToolTipService.ToolTip="Toggle the navigation pane">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE700;" />
            </Button>

            <StackPanel
                Grid.Column="1"
                Margin="8,0,12,0"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceXS}">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="{StaticResource IconSizeLarge}"
                    Glyph="&#xE787;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource App.TextSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Calendar" />
            </StackPanel>

            <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Click="OnTodayClick"
                        Content="Today"
                        AutomationProperties.Name="Go to today"
                        ToolTipService.ToolTip="Go to today (T)" />
                    <Button
                        Click="OnPreviousClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Previous period"
                        ToolTipService.ToolTip="Previous period (Left arrow)">
                        <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        Click="OnNextClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Next period"
                        ToolTipService.ToolTip="Next period (Right arrow)">
                        <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE72A;" />
                    </Button>
                    <TextBlock
                        x:Name="PeriodLabelText"
                        Margin="{StaticResource MarginPeriodLabel}"
                        VerticalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind StateViewModel.PeriodLabel, Mode=OneWay}"
                        AutomationProperties.Name="Current period" />
                </StackPanel>

                <muxc:SelectorBar
                    x:Name="ViewSwitcher"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    SelectionChanged="OnViewSwitcherSelectionChanged"
                    AutomationProperties.Name="Calendar view">
                    <muxc:SelectorBarItem Tag="Day" Text="Day" />
                    <muxc:SelectorBarItem Tag="Week" Text="Week" IsSelected="True" />
                    <muxc:SelectorBarItem Tag="Month" Text="Month" />
                    <muxc:SelectorBarItem Tag="Agenda" Text="Agenda" />
                </muxc:SelectorBar>

            </Grid>

            <StackPanel
                Grid.Column="3"
                Margin="{StaticResource MarginEndCaption}"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceXS}">

                <Button
                    x:Name="ViewOptionsButton"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="View options"
                    ToolTipService.ToolTip="View options (weekends, week numbers, time zone)">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <muxc:MenuFlyout>
                            <muxc:ToggleMenuFlyoutItem
                                AutomationProperties.Name="Show weekends"
                                IsChecked="{x:Bind WeekViewModel.ShowWeekends, Mode=TwoWay}"
                                Text="Show weekends" />
                            <muxc:ToggleMenuFlyoutItem
                                AutomationProperties.Name="Show week numbers for the week view"
                                IsChecked="{x:Bind WeekViewModel.ShowWeekNumbers, Mode=TwoWay}"
                                Text="Show week numbers (week)" />
                            <muxc:ToggleMenuFlyoutItem
                                AutomationProperties.Name="Show week numbers for the month view"
                                IsChecked="{x:Bind MonthViewModel.ShowWeekNumbers, Mode=TwoWay}"
                                Text="Show week numbers (month)" />
                            <muxc:ToggleMenuFlyoutItem
                                AutomationProperties.Name="Show the secondary time zone column"
                                IsChecked="{x:Bind WeekViewModel.ShowSecondaryTimeZone, Mode=TwoWay}"
                                Text="Secondary time zone" />
                        </muxc:MenuFlyout>
                    </Button.Flyout>
                </Button>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Width="{StaticResource SearchBoxWidth}"
                    VerticalAlignment="Center"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchSubmitted"
                    SuggestionChosen="OnSearchSuggestionSelected"
                    AutomationProperties.Name="Search events"
                    ToolTipService.ToolTip="Search events (Ctrl+F)" />

                <Button
                    x:Name="SearchFiltersButton"
                    Content="Filters"
                    Click="OnSearchFiltersClick"
                    AutomationProperties.Name="Open search filters"
                    ToolTipService.ToolTip="Filter by date, tags, or category">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MinWidth="280" Spacing="{StaticResource SpaceSM}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Search filters" />
                                <CheckBox x:Name="SearchFromEnabled" Content="Limit from date" />
                                <DatePicker x:Name="SearchFromDate" Header="From date" />
                                <CheckBox x:Name="SearchToEnabled" Content="Limit to date" />
                                <DatePicker x:Name="SearchToDate" Header="To date" />
                                <TextBox x:Name="SearchTagsBox" Header="Tags" PlaceholderText="work, travel" />
                                <TextBox x:Name="SearchCategoryBox" Header="Category" PlaceholderText="Meeting" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                                    <Button Content="Apply" Click="OnApplySearchFiltersClick" />
                                    <Button Content="Clear" Click="OnClearSearchFiltersClick" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Click="OnSyncClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Sync now"
                    ToolTipService.ToolTip="Sync now">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE895;" />
                </Button>

                <Button
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Export schedule"
                    ToolTipService.ToolTip="Export schedule">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE749;" />
                    <Button.Flyout>
                        <muxc:MenuFlyout>
                            <muxc:MenuFlyoutItem Text="Export PDF" Click="OnExportPdfClick" />
                            <muxc:MenuFlyoutItem Text="Export HTML" Click="OnExportHtmlClick" />
                        </muxc:MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Click="OnSettingsClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE713;" />
                </Button>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

            <Grid
                x:Name="SidebarHost"
                Grid.Column="0"
                Width="{StaticResource SidebarWidth}"
                Background="{ThemeResource App.SidebarBackgroundBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="MiniCalendarHost" Grid.Row="0" />

                <muxc:SplitButton
                    x:Name="NewSplitButton"
                    Grid.Row="1"
                    Margin="{StaticResource InsetSM}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnNewSplitButtonClick"
                    AutomationProperties.Name="Create a new event or reminder">
                    <muxc:SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE710;" />
                            <TextBlock Text="New" />
                        </StackPanel>
                    </muxc:SplitButton.Content>
                    <muxc:SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem AutomationProperties.Name="New event" Click="OnNewEventClick" Text="Event" />
                            <MenuFlyoutItem AutomationProperties.Name="New reminder" Click="OnNewReminderClick" Text="Reminder" />
                            <MenuFlyoutItem AutomationProperties.Name="New task" Click="OnNewTaskClick" Text="Task" />
                        </MenuFlyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="{StaticResource PaddingSidebar}" Spacing="{StaticResource SpaceXS}">

                        <muxc:Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="True"
                            AutomationProperties.Name="Calendars">
                            <muxc:Expander.Header>
                                <TextBlock
                                    Style="{StaticResource SectionHeaderStyle}"
                                    Text="CALENDARS" />
                            </muxc:Expander.Header>
                            <ListView
                                x:Name="CalendarList"
                                ItemsSource="{x:Bind ViewModel.Calendars, Mode=OneWay}"
                                SelectionMode="None"
                                RightTapped="OnCalendarListRightTapped"
                                AutomationProperties.Name="Calendars">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarListItem">
                                        <Grid MinHeight="{StaticResource SidebarRowHeight}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                            <Border
                                                Grid.Column="1"
                                                Width="{StaticResource CalendarSwatchSize}"
                                                Height="{StaticResource CalendarSwatchSize}"
                                                Margin="{StaticResource MarginStartSmall}"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind ColorBrush, Mode=OneWay}"
                                                CornerRadius="{StaticResource RadiusSwatch}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="{StaticResource MarginStartMedium}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </muxc:Expander>

                        <TextBlock
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="REMINDERS" />

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.ReminderLists, Mode=OneWay}"
                            AutomationProperties.Name="Reminder lists">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationListItem">
                                    <Grid>
                                    <Border
                                        Background="{ThemeResource App.SelectedBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Border
                                        Width="{StaticResource AccentBarWidth}"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource App.AccentBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Button
                                        Click="OnSidebarRowClicked"
                                        Style="{StaticResource SidebarRowStyle}"
                                        Tag="{x:Bind TargetKey, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource IconSizeMedium}"
                                                Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="{StaticResource MarginStartMedium}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Label, Mode=OneWay}" />
                                            <Border
                                                Grid.Column="2"
                                                MinWidth="20"
                                                Padding="6,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource App.HoverBrush}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Count, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="TASKS" />

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.TaskLists, Mode=OneWay}"
                            AutomationProperties.Name="Task lists">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationListItem">
                                    <Grid>
                                    <Border
                                        Background="{ThemeResource App.SelectedBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Border
                                        Width="{StaticResource AccentBarWidth}"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource App.AccentBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Button
                                        Click="OnSidebarRowClicked"
                                        Style="{StaticResource SidebarRowStyle}"
                                        Tag="{x:Bind TargetKey, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource IconSizeMedium}"
                                                Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="{StaticResource MarginStartMedium}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Label, Mode=OneWay}" />
                                            <Border
                                                Grid.Column="2"
                                                MinWidth="20"
                                                Padding="6,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource App.HoverBrush}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Count, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Row="3"
                    Padding="12"
                    BorderBrush="{ThemeResource App.DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Background="Transparent"
                    ColumnDefinitions="*,Auto">
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceSM}"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontSize="{StaticResource IconSizeSmall}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}"
                            AutomationProperties.Name="Sync status" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource App.HoverBrush}"
                        CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXXS}">
                            <FontIcon
                                FontSize="{StaticResource IconSizeSmall}"
                                Glyph="&#xE734;" />
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Premium" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <muxc:InfoBar
                        x:Name="StatusInfoBar"
                        Margin="12,12,12,0"
                        VerticalAlignment="Top"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational"
                        Closed="OnStatusInfoBarClosed"
                        AutomationProperties.Name="Status message" />

                    <muxc:InfoBar
                        x:Name="InvitationInfoBar"
                        Margin="12,64,12,0"
                        VerticalAlignment="Top"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational"
                        Title="Invitation"
                        Message="You have been invited to this event."
                        AutomationProperties.Name="Event invitation">
                        <muxc:InfoBar.ActionButton>
                            <Button Click="OnInvitationRespondClick" Content="Respond" AutomationProperties.Name="Respond to invitation" />
                        </muxc:InfoBar.ActionButton>
                    </muxc:InfoBar>

                    <Frame x:Name="ContentFrame" />

                </Grid>
            </Border>

                <Grid
                    x:Name="EditorHost"
                    Grid.Column="2"
                    Width="{StaticResource EditorPaneWidth}"
                    Visibility="Collapsed" />

        </Grid>

        <StackPanel
            x:Name="SidebarIconRail"
            Grid.Row="1"
            Width="{StaticResource SidebarCollapsedWidth}"
            Padding="6,8,6,8"
            Spacing="{StaticResource SpaceXS}"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Button
                Click="OnNewSplitButtonClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Create a new event or reminder"
                ToolTipService.ToolTip="New event (N)">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE710;" />
            </Button>
            <Button
                Click="OnTodayClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Go to today"
                ToolTipService.ToolTip="Go to today (T)">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE787;" />
            </Button>
            <Button
                Click="OnDayViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Day view"
                ToolTipService.ToolTip="Day view (D)">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE7B3;" />
            </Button>
            <Button
                Click="OnWeekViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Week view"
                ToolTipService.ToolTip="Week view (W)">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE7B4;" />
            </Button>
            <Button
                Click="OnMonthViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Month view"
                ToolTipService.ToolTip="Month view (M)">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE7B5;" />
            </Button>
            <Button
                Click="OnAgendaViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Agenda view"
                ToolTipService.ToolTip="Agenda view (A)">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE8A5;" />
            </Button>
            <Button
                Click="OnTasksClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Tasks"
                ToolTipService.ToolTip="Tasks">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE9D5;" />
            </Button>
        </StackPanel>

        <ctrl:SnackbarView
            x:Name="Snackbar"
            Grid.Row="1"
            Width="{StaticResource SnackbarWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="{StaticResource MarginSnackbar}"
            Visibility="Collapsed" />

    </Grid>

</Window>
