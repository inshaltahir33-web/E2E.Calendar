<Window
    x:Class="E2E.Calendar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:muxcp="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:views="using:E2E.Calendar.App.Views"
    xmlns:vm="using:E2E.Calendar.App.ViewModels"
    Title="E2E Calendar">

    <!-- FIX 1: KeyboardAcceleratorPlacementMode="Hidden" removes the stray "N" badge that followed the cursor. -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource App.WindowBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden"
        RowDefinitions="Auto,*">

        <Grid.Resources>
            <!-- One shared template for Reminders, Tasks and Tags rows. Selected rows use the
                 AccentSoft pill from SidebarRowStyle. -->
            <DataTemplate x:Key="NavItemTemplate" x:DataType="vm:NavigationListItem">
                <Grid>
                    <!-- AccentSoft selected pill. -->
                    <Border
                        Background="{ThemeResource App.SelectedBrush}"
                        CornerRadius="{StaticResource RadiusPill}"
                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                    <Button
                        Click="OnSidebarRowClicked"
                        Style="{StaticResource SidebarRowStyle}"
                        CornerRadius="{StaticResource RadiusPill}"
                        Tag="{x:Bind}"
                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="{StaticResource IconSizeMedium}"
                                Glyph="{x:Bind Glyph, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="{StaticResource MarginStartMedium}"
                                VerticalAlignment="Center"
                                Text="{x:Bind Label, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="2"
                                MinWidth="20"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource App.AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusPill}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Count, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <!-- FIX 3: Up/Down arrow accelerators removed (they hijacked scrolling and list navigation).
             Left/Right kept. Single-key shortcuts must be guarded in code-behind (see ApplyShellFixes). -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Invoked="OnNewAccelerator"/>
            <KeyboardAccelerator Key="R" Invoked="OnNewReminderAccelerator"/>
            <KeyboardAccelerator Key="T" Invoked="OnTodayAccelerator"/>
            <KeyboardAccelerator Key="D" Invoked="OnDayViewAccelerator"/>
            <KeyboardAccelerator Key="W" Invoked="OnWeekViewAccelerator"/>
            <KeyboardAccelerator Key="M" Invoked="OnMonthViewAccelerator"/>
            <KeyboardAccelerator Key="A" Invoked="OnAgendaViewAccelerator"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteAccelerator"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator"/>
            <KeyboardAccelerator Key="Left" Invoked="OnPreviousAccelerator"/>
            <KeyboardAccelerator Key="Right" Invoked="OnNextAccelerator"/>
        </Grid.KeyboardAccelerators>

        <!-- ================= TOP BAR (48px) ================= -->
        <Grid
            x:Name="TitleBarElement"
            Grid.Row="0"
            Height="{StaticResource TitleBarHeight}"
            Padding="{StaticResource PaddingTitleBar}"
            Background="{ThemeResource App.TransparentBrush}"
            ColumnDefinitions="Auto,*,Auto">

            <!-- LEFT: sidebar toggle, period navigation, period/page title. -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="{StaticResource SpaceXS}">
                <Button
                    x:Name="SidebarToggleButton"
                    Click="OnSidebarToggleClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Toggle sidebar"
                    ToolTipService.ToolTip="Show or hide the sidebar">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE700;" />
                </Button>

                <Grid VerticalAlignment="Center">
                    <StackPanel
                        x:Name="PeriodNavigationPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceXS}">
                        <Button
                            Click="OnTodayClick"
                            Content="Today"
                            Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Go to today"
                            ToolTipService.ToolTip="Go to today (T)" />
                        <Button
                            Click="OnPreviousClick"
                            Style="{StaticResource GhostButtonStyle}"
                            AutomationProperties.Name="Previous period"
                            ToolTipService.ToolTip="Previous period (Left arrow)">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE72B;" />
                        </Button>
                        <Button
                            Click="OnNextClick"
                            Style="{StaticResource GhostButtonStyle}"
                            AutomationProperties.Name="Next period"
                            ToolTipService.ToolTip="Next period (Right arrow)">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE72A;" />
                        </Button>
                        <!-- Title is computed from the state view model (visible period + view mode),
                             so it follows the arrows, the view switcher and Today. -->
                        <TextBlock
                            x:Name="PeriodLabelText"
                            MinWidth="160"
                            Margin="{StaticResource MarginPeriodLabel}"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeSubtitle}"
                            FontWeight="SemiBold"
                            Text="{x:Bind StateViewModel.PeriodLabel, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.Name="Current period" />
                    </StackPanel>

                    <!-- Shown instead of the period navigation on Settings / Tasks / Reminders. -->
                    <TextBlock
                        x:Name="PageTitleText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeSubtitle}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Page title" />
                </Grid>
            </StackPanel>

            <!-- RIGHT: view switcher, search (with filter), overflow. -->
            <StackPanel
                Grid.Column="2"
                Margin="{StaticResource MarginEndCaption}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceXS}">

                <muxc:SelectorBar
                    x:Name="ViewSwitcher"
                    Style="{StaticResource ViewSwitcherStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectionChanged="OnViewSwitcherSelectionChanged"
                    AutomationProperties.Name="Calendar view">
                    <muxc:SelectorBarItem Tag="Day" Text="Day" Style="{StaticResource ViewSwitcherItemStyle}" />
                    <muxc:SelectorBarItem Tag="Week" Text="Week" IsSelected="True" Style="{StaticResource ViewSwitcherItemStyle}" />
                    <muxc:SelectorBarItem Tag="Month" Text="Month" Style="{StaticResource ViewSwitcherItemStyle}" />
                    <muxc:SelectorBarItem Tag="Agenda" Text="Agenda" Style="{StaticResource ViewSwitcherItemStyle}" />
                </muxc:SelectorBar>

                <!-- Search box with the filter icon inside it. -->
                <Grid
                    Width="{StaticResource SearchBoxWidth}"
                    VerticalAlignment="Center">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Padding="12,0,64,0"
                        VerticalAlignment="Center"
                        PlaceholderText="Search"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                        TextChanged="OnSearchTextChanged"
                        QuerySubmitted="OnSearchSubmitted"
                        SuggestionChosen="OnSearchSuggestionSelected"
                        AutomationProperties.Name="Search events"
                        ToolTipService.ToolTip="Search events (Ctrl+F)" />
                    <Button
                        x:Name="SearchFiltersButton"
                        Click="OnSearchFiltersClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,0,32,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Open search filters"
                        ToolTipService.ToolTip="Narrow search results by date, tags or category">
                        <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE71C;" />
                        <Button.Flyout>
                            <Flyout
                                FlyoutPresenterStyle="{StaticResource AppFlyoutPresenterStyle}"
                                Placement="BottomEdgeAlignedRight">
                                <StackPanel MinWidth="320" Spacing="{StaticResource SpaceMD}">
                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Filter search results" />
                                        <TextBlock
                                            Style="{StaticResource SettingsCardDescriptionStyle}"
                                            Text="Type in Search first, then choose filters here and press Apply. Only matching events are shown." />
                                    </StackPanel>

                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <CheckBox
                                            x:Name="SearchFromEnabled"
                                            Content="From date"
                                            Checked="OnSearchDateFilterToggled"
                                            Unchecked="OnSearchDateFilterToggled" />
                                        <CalendarDatePicker
                                            x:Name="SearchFromDate"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            PlaceholderText="Any date"
                                            AutomationProperties.Name="From date" />
                                    </StackPanel>

                                    <StackPanel Spacing="{StaticResource SpaceXS}">
                                        <CheckBox
                                            x:Name="SearchToEnabled"
                                            Content="To date"
                                            Checked="OnSearchDateFilterToggled"
                                            Unchecked="OnSearchDateFilterToggled" />
                                        <CalendarDatePicker
                                            x:Name="SearchToDate"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            PlaceholderText="Any date"
                                            AutomationProperties.Name="To date" />
                                    </StackPanel>

                                    <TextBox
                                        x:Name="SearchTagsBox"
                                        PlaceholderText="e.g. work, travel"
                                        PlaceholderForeground="{ThemeResource App.TextSecondaryBrush}"
                                        AutomationProperties.Name="Tags" />

                                    <ComboBox
                                        x:Name="SearchCategoryBox"
                                        HorizontalAlignment="Stretch"
                                        IsEditable="True"
                                        PlaceholderText="Any category"
                                        AutomationProperties.Name="Category">
                                        <x:String>Meeting</x:String>
                                        <x:String>Personal</x:String>
                                        <x:String>Travel</x:String>
                                        <x:String>Focus</x:String>
                                    </ComboBox>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSM}">
                                        <Button
                                            HorizontalAlignment="Left"
                                            Content="Clear"
                                            Click="OnClearSearchFiltersClick"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="Clear search filters" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Apply"
                                            Click="OnApplySearchFiltersClick"
                                            Style="{StaticResource AccentButtonStyle}"
                                            AutomationProperties.Name="Apply search filters" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Overflow menu: view options, exports, sync. -->
                <Button
                    x:Name="ViewOptionsButton"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="More options"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <muxc:MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}">
                            <muxc:ToggleMenuFlyoutItem
                                AutomationProperties.Name="Show weekends"
                                IsChecked="{x:Bind WeekViewModel.ShowWeekends, Mode=TwoWay}"
                                Style="{StaticResource AppToggleMenuFlyoutItemStyle}"
                                Text="Show weekends" />
                            <muxc:ToggleMenuFlyoutItem
                                x:Name="ShowWeekNumbersToggle"
                                AutomationProperties.Name="Show week numbers"
                                Click="OnShowWeekNumbersClick"
                                IsChecked="{x:Bind WeekViewModel.ShowWeekNumbers, Mode=TwoWay}"
                                Style="{StaticResource AppToggleMenuFlyoutItemStyle}"
                                Text="Show week numbers" />
                            <muxc:ToggleMenuFlyoutItem
                                AutomationProperties.Name="Show the secondary time zone column"
                                IsChecked="{x:Bind WeekViewModel.ShowSecondaryTimeZone, Mode=TwoWay}"
                                Style="{StaticResource AppToggleMenuFlyoutItemStyle}"
                                Text="Secondary time zone" />
                            <muxc:MenuFlyoutSeparator />
                            <muxc:MenuFlyoutItem
                                Click="OnExportPdfClick"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Export PDF" />
                            <muxc:MenuFlyoutItem
                                Click="OnExportHtmlClick"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Export HTML" />
                            <muxc:MenuFlyoutSeparator />
                            <muxc:MenuFlyoutItem
                                x:Name="SyncMenuItem"
                                Click="OnSyncClick"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="Sync now" />
                            <muxc:MenuFlyoutItem
                                x:Name="SyncStatusText"
                                IsEnabled="False"
                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}" />
                        </muxc:MenuFlyout>
                    </Button.Flyout>
                </Button>

            </StackPanel>

        </Grid>

        <!-- ================= BODY ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!-- SIDEBAR: one scrollable column with New, mini calendar, calendars, reminders,
                 tasks and tags. Settings + collapse stay pinned at the bottom. -->
            <Grid
                x:Name="SidebarColumn"
                Grid.Column="0"
                Width="{StaticResource SidebarWidth}"
                Background="{ThemeResource App.SidebarBackgroundBrush}">
                <Grid
                    x:Name="SidebarHost"
                    Background="{ThemeResource App.SidebarBackgroundBrush}"
                    RowDefinitions="*,Auto">

                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,8,12,44" Spacing="{StaticResource SpaceXS}">

                            <!-- Menu-only "New" button: the flyout opens on click; opening the
                                 editor is done by its "Event" item (same OpenNewEvent path as
                                 every other entry point). Disabled while the editor is open so
                                 the menu can never appear on top of it. -->
                            <Button
                                x:Name="NewMenuButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                IsEnabled="{x:Bind EditorViewModel.IsMenuEnabled, Mode=OneWay}"
                                AutomationProperties.Name="New event, reminder or task"
                                ToolTipService.ToolTip="New (N)">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE710;" />
                                    <TextBlock Text="New" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource AppMenuFlyoutPresenterStyle}">
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="New event"
                                            Click="OnNewEventClick"
                                            KeyboardAcceleratorTextOverride="N"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Event" />
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="New reminder"
                                            Click="OnNewReminderClick"
                                            KeyboardAcceleratorTextOverride="R"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Reminder" />
                                        <MenuFlyoutSubItem
                                            AutomationProperties.Name="Remind me in"
                                            Text="Remind me in">
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="Remind me in 10 minutes"
                                                Click="OnNewCountdownClick"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Tag="10"
                                                Text="10 minutes" />
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="Remind me in 30 minutes"
                                                Click="OnNewCountdownClick"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Tag="30"
                                                Text="30 minutes" />
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="Remind me in 60 minutes"
                                                Click="OnNewCountdownClick"
                                                Style="{StaticResource AppMenuFlyoutItemStyle}"
                                                Tag="60"
                                                Text="60 minutes" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="New task"
                                            Click="OnNewTaskClick"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Task" />
                                        <MenuFlyoutItem
                                            AutomationProperties.Name="Quick add"
                                            Click="OnQuickAddClick"
                                            KeyboardAcceleratorTextOverride="Win+Alt+C"
                                            Style="{StaticResource AppMenuFlyoutItemStyle}"
                                            Text="Quick add" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- Viewbox keeps the fixed-cell mini calendar inside the 264px sidebar
                                 instead of letting it clip against the calendar list. -->
                            <Viewbox
                                HorizontalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <Grid
                                    x:Name="MiniCalendarHost"
                                    Margin="0,4,0,8" />
                            </Viewbox>

                            <muxc:Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsExpanded="True"
                                AutomationProperties.Name="My calendars">
                                <muxc:Expander.Header>
                                    <TextBlock
                                        Style="{StaticResource SectionHeaderStyle}"
                                        Text="My calendars" />
                                </muxc:Expander.Header>
                                <ListView
                                    x:Name="CalendarList"
                                    ItemsSource="{x:Bind ViewModel.Calendars, Mode=OneWay}"
                                    SelectionMode="None"
                                    RightTapped="OnCalendarListRightTapped"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    AutomationProperties.Name="My calendars">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarListItem">
                                            <Grid MinHeight="{StaticResource SidebarRowHeight}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    MinWidth="0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                    IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="{StaticResource CalendarSwatchSize}"
                                                    Height="{StaticResource CalendarSwatchSize}"
                                                    Margin="{StaticResource MarginStartSmall}"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind ColorBrush, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="{StaticResource MarginStartMedium}"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </muxc:Expander>

                            <TextBlock
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="REMINDERS" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.ReminderLists, Mode=OneWay}"
                                ItemTemplate="{StaticResource NavItemTemplate}"
                                AutomationProperties.Name="Reminder lists" />

                            <TextBlock
                                Style="{StaticResource SectionHeaderStyle}"
                                Text="LISTS" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.TaskLists, Mode=OneWay}"
                                ItemTemplate="{StaticResource NavItemTemplate}"
                                RightTapped="OnTaskListRightTapped"
                                AutomationProperties.Name="Lists" />
                            <Button
                                Margin="4,2,4,0"
                                Padding="12,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="{ThemeResource App.TransparentBrush}"
                                BorderThickness="0"
                                Click="OnNewListClick"
                                AutomationProperties.Name="New list"
                                ToolTipService.ToolTip="Create a list">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="{StaticResource IconSizeMedium}"
                                        Glyph="&#xE710;"
                                        Foreground="{ThemeResource App.AccentBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource App.AccentBrush}"
                                        Text="New list" />
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="TagsSection" Visibility="Collapsed">
                                <TextBlock
                                    Style="{StaticResource SectionHeaderStyle}"
                                    Text="TAGS" />
                                <ItemsControl
                                    x:Name="TagList"
                                    ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}"
                                    ItemTemplate="{StaticResource NavItemTemplate}"
                                    AutomationProperties.Name="Tags" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned footer: settings + collapse. -->
                    <Grid
                        Grid.Row="1"
                        Padding="8,4,8,8"
                        Background="{ThemeResource App.SidebarBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="0,1,0,0"
                        ColumnDefinitions="Auto,*">
                        <Button
                            Click="OnSettingsClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Settings"
                            ToolTipService.ToolTip="Settings">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE713;" />
                        </Button>
                        <Button
                            Grid.Column="1"
                            Click="OnSidebarToggleClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Collapse sidebar"
                            ToolTipService.ToolTip="Collapse sidebar">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE76B;" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- ICON RAIL: shown instead of the full sidebar when the window is narrow. -->
                <StackPanel
                    x:Name="SidebarIconRail"
                    Width="{StaticResource SidebarCollapsedWidth}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Padding="{StaticResource PaddingIconRail}"
                    Spacing="{StaticResource SpaceXXS}"
                    Visibility="Collapsed">
                    <Button Click="OnNewSplitButtonClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Create a new event or reminder" ToolTipService.ToolTip="New (N)"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE710;" /></Button>
                    <Button Click="OnTodayClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Go to today" ToolTipService.ToolTip="Today (T)"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE787;" /></Button>
                    <Button Click="OnDayViewClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Day view" ToolTipService.ToolTip="Day view (D)"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE7B3;" /></Button>
                    <Button Click="OnWeekViewClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Week view" ToolTipService.ToolTip="Week view (W)"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE7B4;" /></Button>
                    <Button Click="OnMonthViewClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Month view" ToolTipService.ToolTip="Month view (M)"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE7B5;" /></Button>
                    <Button Click="OnAgendaViewClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Agenda view" ToolTipService.ToolTip="Agenda view (A)"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE8A5;" /></Button>
                    <Button Click="OnTasksClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Tasks" ToolTipService.ToolTip="Tasks"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE9D5;" /></Button>
                    <Button Click="OnSettingsClick" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"><FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE713;" /></Button>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Frame x:Name="ContentFrame" />

                    <!-- FIX 9: both InfoBars stacked in one panel (they used hardcoded margins 12 / 64 and could overlap). -->
                    <StackPanel
                        Margin="12,12,12,0"
                        VerticalAlignment="Top"
                        Spacing="8">
                        <muxc:InfoBar
                            x:Name="StatusInfoBar"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Informational"
                            Closed="OnStatusInfoBarClosed"
                            AutomationProperties.Name="Status message" />
                        <muxc:InfoBar
                            x:Name="InvitationInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Title="Invitation"
                            Message="You have been invited to this event."
                            AutomationProperties.Name="Event invitation">
                            <muxc:InfoBar.ActionButton>
                                <Button Click="OnInvitationRespondClick" Content="Respond" AutomationProperties.Name="Respond to invitation" />
                            </muxc:InfoBar.ActionButton>
                        </muxc:InfoBar>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- EDITOR SCRIM: light dismiss layer behind the drawer. Overlay only —
                 zero layout footprint, does not touch the sidebar/content columns. -->
            <Border
                x:Name="EditorScrim"
                Grid.ColumnSpan="2"
                Background="{ThemeResource App.ScrimBrush}"
                Visibility="Collapsed"
                Tapped="OnEditorScrimTapped"
                AutomationProperties.Name="Close the event editor" />

            <!-- EDITOR DRAWER (right): fixed-width overlay pinned to the right edge, full
                 height. It spans the same cell as sidebar + content as a LATER sibling, so
                 opening/closing it never changes the calendar grid's or sidebar's width,
                 position or scroll offset. Never a layout column / Inline pane. -->
            <Grid
                x:Name="EditorHost"
                Grid.ColumnSpan="2"
                Width="{StaticResource EditorPaneWidth}"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        </Grid>

        <ctrl:SnackbarView
            x:Name="Snackbar"
            Grid.Row="1"
            Width="{StaticResource SnackbarWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="{StaticResource MarginSnackbar}"
            Visibility="Collapsed" />

    </Grid>

</Window>