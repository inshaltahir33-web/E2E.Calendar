<Window
    x:Class="E2E.Calendar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:muxcp="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:views="using:E2E.Calendar.App.Views"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        RowDefinitions="Auto,*">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Invoked="OnNewAccelerator"/>
            <KeyboardAccelerator Key="R" Invoked="OnNewReminderAccelerator"/>
            <KeyboardAccelerator Key="T" Invoked="OnTodayAccelerator"/>
            <KeyboardAccelerator Key="D" Invoked="OnDayViewAccelerator"/>
            <KeyboardAccelerator Key="W" Invoked="OnWeekViewAccelerator"/>
            <KeyboardAccelerator Key="M" Invoked="OnMonthViewAccelerator"/>
            <KeyboardAccelerator Key="A" Invoked="OnAgendaViewAccelerator"/>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnCommandPaletteAccelerator"/>
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator"/>
            <KeyboardAccelerator Key="Left" Invoked="OnPreviousAccelerator"/>
            <KeyboardAccelerator Key="Right" Invoked="OnNextAccelerator"/>
            <KeyboardAccelerator Key="Up" Invoked="OnPreviousAccelerator"/>
            <KeyboardAccelerator Key="Down" Invoked="OnNextAccelerator"/>
        </Grid.KeyboardAccelerators>

        <Grid
            x:Name="TitleBarElement"
            Grid.Row="0"
            Height="{StaticResource TitleBarHeight}"
            Padding="{StaticResource PaddingTitleBar}"
            Background="Transparent"
            ColumnDefinitions="Auto,Auto,Auto,Auto">

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="0"
                Click="OnPaneToggleClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Toggle the navigation pane"
                ToolTipService.ToolTip="Toggle the navigation pane">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE700;" />
            </Button>

            <StackPanel
                Grid.Column="1"
                Margin="{StaticResource MarginStartMedium}"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceXS}">
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="{StaticResource IconSizeLarge}"
                    Glyph="&#xE787;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Calendar" />
            </StackPanel>

            <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button
                        Click="OnTodayClick"
                        Content="Today"
                        AutomationProperties.Name="Go to today" />
                    <Button
                        Click="OnPreviousClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Previous period"
                        ToolTipService.ToolTip="Previous period">
                        <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        Click="OnNextClick"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Next period"
                        ToolTipService.ToolTip="Next period">
                        <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE72A;" />
                    </Button>
                    <TextBlock
                        x:Name="PeriodLabelText"
                        Margin="{StaticResource MarginPeriodLabel}"
                        VerticalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind StateViewModel.PeriodLabel, Mode=OneWay}"
                        AutomationProperties.Name="Current period" />
                </StackPanel>

                <muxc:SelectorBar
                    x:Name="ViewSwitcher"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    SelectionChanged="OnViewSwitcherSelectionChanged"
                    AutomationProperties.Name="Calendar view">
                    <muxc:SelectorBarItem Tag="Day" Text="Day" />
                    <muxc:SelectorBarItem Tag="Week" Text="Week" IsSelected="True" />
                    <muxc:SelectorBarItem Tag="Month" Text="Month" />
                    <muxc:SelectorBarItem Tag="Agenda" Text="Agenda" />
                </muxc:SelectorBar>

            </Grid>

            <StackPanel
                Grid.Column="3"
                Margin="{StaticResource MarginEndCaption}"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceXS}">

                <Button
                    x:Name="ViewOptionsButton"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="View options"
                    ToolTipService.ToolTip="View options">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <muxc:MenuFlyout>
                            <muxc:ToggleMenuFlyoutItem
                                IsChecked="{x:Bind WeekViewModel.ShowWeekends, Mode=TwoWay}"
                                Text="Show weekends" />
                            <muxc:ToggleMenuFlyoutItem
                                IsChecked="{x:Bind WeekViewModel.ShowWeekNumbers, Mode=TwoWay}"
                                Text="Show week numbers" />
                            <muxc:ToggleMenuFlyoutItem
                                IsChecked="{x:Bind WeekViewModel.ShowSecondaryTimeZone, Mode=TwoWay}"
                                Text="Secondary time zone" />
                        </muxc:MenuFlyout>
                    </Button.Flyout>
                </Button>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Width="{StaticResource SearchBoxWidth}"
                    VerticalAlignment="Center"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                    AutomationProperties.Name="Search events" />

                <Button
                    Click="OnSyncClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Sync now"
                    ToolTipService.ToolTip="Sync now">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE895;" />
                </Button>

                <Button
                    Click="OnSettingsClick"
                    Style="{StaticResource ToolbarButtonStyle}"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE713;" />
                </Button>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

            <Grid
                x:Name="SidebarHost"
                Grid.Column="0"
                Width="{StaticResource SidebarWidth}"
                Background="Transparent">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    Height="{StaticResource MiniCalendarHeight}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <CalendarView
                        x:Name="MiniCalendar"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        MinWidth="{StaticResource MiniCalendarMinWidth}"
                        SelectedDatesChanged="OnMiniCalendarSelectedDatesChanged"
                        AutomationProperties.Name="Mini calendar" />
                </ScrollViewer>

                <muxc:SplitButton
                    x:Name="NewSplitButton"
                    Grid.Row="1"
                    Margin="{StaticResource InsetSM}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnNewSplitButtonClick"
                    AutomationProperties.Name="Create a new event or reminder">
                    <muxc:SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE710;" />
                            <TextBlock Text="New" />
                        </StackPanel>
                    </muxc:SplitButton.Content>
                    <muxc:SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnNewEventClick" Text="Event" />
                            <MenuFlyoutItem Click="OnNewReminderClick" Text="Reminder" />
                            <MenuFlyoutItem Click="OnNewTaskClick" Text="Task" />
                        </MenuFlyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="{StaticResource PaddingSidebar}" Spacing="{StaticResource SpaceXS}">

                        <muxc:Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="True"
                            AutomationProperties.Name="Calendars">
                            <muxc:Expander.Header>
                                <TextBlock
                                    Style="{StaticResource SectionHeaderStyle}"
                                    Text="CALENDARS" />
                            </muxc:Expander.Header>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Calendars, Mode=OneWay}"
                                SelectionMode="None"
                                AutomationProperties.Name="Calendars">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarListItem">
                                        <Grid MinHeight="{StaticResource SidebarRowHeight}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                            <Border
                                                Grid.Column="1"
                                                Width="{StaticResource CalendarSwatchSize}"
                                                Height="{StaticResource CalendarSwatchSize}"
                                                Margin="{StaticResource MarginStartSmall}"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind ColorBrush, Mode=OneWay}"
                                                CornerRadius="{StaticResource RadiusSwatch}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="{StaticResource MarginStartMedium}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </muxc:Expander>

                        <TextBlock
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="REMINDERS" />

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.ReminderLists, Mode=OneWay}"
                            AutomationProperties.Name="Reminder lists">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationListItem">
                                    <Grid>
                                    <Border
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Border
                                        Width="{StaticResource AccentBarWidth}"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Button
                                        Click="OnSidebarRowClicked"
                                        Style="{StaticResource SidebarRowStyle}"
                                        Tag="{x:Bind TargetKey, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource IconSizeMedium}"
                                                Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="{StaticResource MarginStartMedium}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Label, Mode=OneWay}" />
                                            <Border
                                                Grid.Column="2"
                                                MinWidth="20"
                                                Padding="6,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Count, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="TASKS" />

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.TaskLists, Mode=OneWay}"
                            AutomationProperties.Name="Task lists">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationListItem">
                                    <Grid>
                                    <Border
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Border
                                        Width="{StaticResource AccentBarWidth}"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind AccentVisibility, Mode=OneWay}" />
                                    <Button
                                        Click="OnSidebarRowClicked"
                                        Style="{StaticResource SidebarRowStyle}"
                                        Tag="{x:Bind TargetKey, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource IconSizeMedium}"
                                                Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="{StaticResource MarginStartMedium}"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Label, Mode=OneWay}" />
                                            <Border
                                                Grid.Column="2"
                                                MinWidth="20"
                                                Padding="6,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Count, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Row="3"
                    Padding="{StaticResource PaddingStatusBar}"
                    Background="Transparent"
                    ColumnDefinitions="*,Auto">
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceSM}"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontSize="{StaticResource IconSizeSmall}"
                            Glyph="&#xE73E;" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}"
                            AutomationProperties.Name="Sync status" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXXS}">
                            <FontIcon
                                FontSize="{StaticResource IconSizeSmall}"
                                Glyph="&#xE734;" />
                            <TextBlock
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Premium" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Frame x:Name="ContentFrame" />

                    <StackPanel
                        x:Name="ViewPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceSM}"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="{StaticResource TextSecondaryOpacity}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="This section is not available yet." />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="{StaticResource TextSecondaryOpacity}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

                <Grid
                    x:Name="EditorHost"
                    Grid.Column="2"
                    Width="{StaticResource EditorPaneWidth}"
                    Visibility="Collapsed" />

        </Grid>

        <StackPanel
            x:Name="SidebarIconRail"
            Grid.Row="1"
            Width="{StaticResource SidebarCollapsedWidth}"
            Padding="6,8,6,8"
            Spacing="{StaticResource SpaceXS}"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Button
                Click="OnNewSplitButtonClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Create a new event or reminder"
                ToolTipService.ToolTip="New">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE710;" />
            </Button>
            <Button
                Click="OnTodayClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Go to today"
                ToolTipService.ToolTip="Today">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE787;" />
            </Button>
            <Button
                Click="OnDayViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Day view"
                ToolTipService.ToolTip="Day">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE7B3;" />
            </Button>
            <Button
                Click="OnWeekViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Week view"
                ToolTipService.ToolTip="Week">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE7B4;" />
            </Button>
            <Button
                Click="OnMonthViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Month view"
                ToolTipService.ToolTip="Month">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE7B5;" />
            </Button>
            <Button
                Click="OnAgendaViewClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Agenda view"
                ToolTipService.ToolTip="Agenda">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE8A5;" />
            </Button>
            <Button
                Click="OnTasksClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Tasks"
                ToolTipService.ToolTip="Tasks">
                <FontIcon FontSize="{StaticResource IconSizeLarge}" Glyph="&#xE9D5;" />
            </Button>
        </StackPanel>

        <ctrl:SnackbarView
            x:Name="Snackbar"
            Grid.Row="1"
            Width="{StaticResource SnackbarWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="{StaticResource MarginSnackbar}"
            Visibility="Collapsed" />

    </Grid>

</Window>
