<Page
    x:Class="E2E.Calendar.App.Views.AgendaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="{ThemeResource App.TransparentBrush}" RowDefinitions="Auto,*,Auto">

        <!-- Sticky day header: names the day currently under the top edge of the list. -->
        <Border
            x:Name="StickyHeaderBar"
            Grid.Row="0"
            Background="{ThemeResource App.CardBackgroundBrush}"
            BorderBrush="{ThemeResource GridLine}"
            BorderThickness="0,0,0,1"
            Padding="24,10"
            Visibility="Collapsed">
            <Grid>
                <TextBlock
                    x:Name="StickyHeaderText"
                    FontSize="{StaticResource FontSizeBody}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource App.TextPrimaryBrush}"
                    Text="{x:Bind ViewModel.StickyHeader, Mode=OneWay}"
                    AutomationProperties.Name="Current agenda day" />
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="AgendaScroll"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="24,8"
            ViewChanged="OnViewChanged">

            <muxc:ItemsRepeater
                x:Name="DaysRepeater"
                ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}"
                ElementPrepared="OnDayElementPrepared">
                <muxc:ItemsRepeater.Layout>
                    <muxc:StackLayout Orientation="Vertical" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgendaDayViewModel">
                            <StackPanel>
                                <!-- Day header: small uppercase weekday + date. Today is Accent,
                                     applied in code-behind because IsToday is a plain bool. -->
                                <Border
                                    Margin="0,16,0,2"
                                    Padding="0,0,0,8"
                                    BorderBrush="{ThemeResource GridLine}"
                                    BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <TextBlock
                                            x:Name="AgendaDayHeader"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeSectionHeader}"
                                            FontWeight="SemiBold"
                                            CharacterSpacing="40"
                                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                                            Text="{x:Bind Weekday, Mode=OneTime}" />
                                        <TextBlock
                                            x:Name="AgendaDayDate"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeBody}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource App.TextPrimaryBrush}"
                                            Text="{x:Bind DayText, Mode=OneTime}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                                            Text="{x:Bind CountLabel, Mode=OneTime}" />
                                    </Grid>
                                </Border>
                                <muxc:ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneTime}">
                                    <muxc:ItemsRepeater.Layout>
                                        <muxc:StackLayout Orientation="Vertical" />
                                    </muxc:ItemsRepeater.Layout>
                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AgendaItemViewModel">
                                            <!-- Comfortable 48px row: colour bar | time | title | tick-box. -->
                                            <Grid
                                                MinHeight="{StaticResource AgendaRowHeight}"
                                                Padding="0,0,8,0"
                                                IsTabStop="True"
                                                KeyDown="OnAgendaItemKeyDown"
                                                Tapped="OnAgendaItemTapped"
                                                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                                Background="{ThemeResource App.TransparentBrush}"
                                                ColumnDefinitions="3,*,Auto">
                                                <Border
                                                    x:Name="RowHover"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="3"
                                                    Margin="3,1,0,1"
                                                    Background="{ThemeResource App.HoverBrush}"
                                                    CornerRadius="{StaticResource RadiusSwatch}"
                                                    Opacity="0"
                                                    PointerEntered="OnRowPointerEntered"
                                                    PointerExited="OnRowPointerExited" />
                                                <Border
                                                    Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,8,0,8"
                                                    HorizontalAlignment="Left"
                                                    Background="{x:Bind Color, Mode=OneTime, Converter={StaticResource ColorToBrush}}"
                                                    CornerRadius="2" />
                                                <Grid
                                                    Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Opacity="{x:Bind CompletedOpacity, Mode=OneWay}"
                                                    ColumnDefinitions="72,*,Auto">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource App.TextSecondaryBrush}"
                                                        Text="{x:Bind DisplayTimeLabel, Mode=OneTime}"
                                                        Visibility="{x:Bind TimeVisibility, Mode=OneTime}" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="0,6"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeBody}"
                                                            Foreground="{ThemeResource App.TextPrimaryBrush}"
                                                            Text="{x:Bind Title, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{x:Bind NotCompletedVisibility, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeBody}"
                                                            Foreground="{ThemeResource App.TextTertiaryBrush}"
                                                            Text="{x:Bind Title, Mode=OneTime}"
                                                            TextDecorations="Strikethrough"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{x:Bind CompletedVisibility, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontSize="{StaticResource FontSizeCaption}"
                                                            Foreground="{ThemeResource App.TextTertiaryBrush}"
                                                            Text="{x:Bind Location, Mode=OneTime}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{x:Bind LocationVisibility, Mode=OneTime}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource App.TextSecondaryBrush}"
                                                        Text="{x:Bind CalendarName, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind CalendarVisibility, Mode=OneTime}" />
                                                </Grid>
                                                <!-- Tick-box lives on the right edge of the row. -->
                                                <CheckBox
                                                    Grid.Column="2"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    MinWidth="0"
                                                    IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind CheckboxVisibility, Mode=OneTime}"
                                                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                                    Click="OnItemCheckBoxClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollViewer>

        <ctrl:SkeletonView
            x:Name="Skeleton"
            Grid.Row="1"
            Margin="16"
            Rows="10"
            IsActive="False" />

        <ctrl:EmptyStateView
            x:Name="EmptyStateView"
            Grid.Row="1"
            ActionText="New event"
            Description="Press N or double-click a day in Month view to add something."
            Glyph="&#xE787;"
            Title="Nothing scheduled"
            Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="12,8">
            <Button
                Click="OnLoadEarlierClick"
                Content="Load earlier"
                Visibility="{x:Bind ViewModel.HasEarlier, Mode=OneWay}"
                AutomationProperties.Name="Load earlier agenda items" />
            <Button
                Click="OnLoadLaterClick"
                Content="Load later"
                Visibility="{x:Bind ViewModel.HasLater, Mode=OneWay}"
                AutomationProperties.Name="Load later agenda items" />
        </StackPanel>

    </Grid>

</Page>
