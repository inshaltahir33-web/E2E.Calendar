<Page
    x:Class="E2E.Calendar.App.Views.AgendaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="Transparent" RowDefinitions="Auto,*,Auto">

        <Border
            x:Name="StickyHeaderBar"
            Grid.Row="0"
            Background="{ThemeResource App.CardBackgroundBrush}"
            BorderBrush="{ThemeResource App.DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6"
            Visibility="Collapsed">
            <Grid MaxWidth="720" HorizontalAlignment="Center">
                <TextBlock
                    x:Name="StickyHeaderText"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.StickyHeader, Mode=OneWay}"
                    AutomationProperties.Name="Current agenda day" />
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="AgendaScroll"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="OnViewChanged">

            <muxc:ItemsRepeater
                x:Name="DaysRepeater"
                MaxWidth="720"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}"
                ElementPrepared="OnDayElementPrepared">
                <muxc:ItemsRepeater.Layout>
                    <muxc:StackLayout Orientation="Vertical" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgendaDayViewModel">
                            <StackPanel>
                                <Grid Margin="12,14,12,2" ColumnDefinitions="Auto,Auto,Auto,*">
                                    <TextBlock
                                        x:Name="AgendaDayHeader"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource App.AccentBrush}"
                                        Text="{x:Bind Header, Mode=OneTime}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind DayText, Mode=OneTime}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource App.TextTertiaryBrush}"
                                        Text="{x:Bind CountLabel, Mode=OneTime}" />
                                </Grid>
                                <muxc:ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneTime}">
                                    <muxc:ItemsRepeater.Layout>
                                        <muxc:StackLayout Orientation="Vertical" />
                                    </muxc:ItemsRepeater.Layout>
                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AgendaItemViewModel">
                                            <Grid
                                                Height="48"
                                                IsTabStop="True"
                                                KeyDown="OnAgendaItemKeyDown"
                                                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                                Padding="12,0"
                                                Background="Transparent"
                                                ColumnDefinitions="72,Auto,Auto,*,Auto">
                                                <Border
                                                    x:Name="RowHover"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="5"
                                                    Background="{ThemeResource App.HoverBrush}"
                                                    CornerRadius="4"
                                                    Opacity="0"
                                                    PointerEntered="OnRowPointerEntered"
                                                    PointerExited="OnRowPointerExited" />
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.7"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind TimeLabel, Mode=OneTime}"
                                                    Visibility="{x:Bind TimeVisibility, Mode=OneTime}" />
                                                <CheckBox
                                                    Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    MinWidth="0"
                                                    IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind CheckboxVisibility, Mode=OneTime}"
                                                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                                    Click="OnItemCheckBoxClick" />
                                                <Border
                                                    Grid.Column="2"
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind Color, Mode=OneTime, Converter={StaticResource ColorToBrush}}"
                                                    CornerRadius="4" />
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Text="{x:Bind Title, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind NotCompletedVisibility, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeBody}"
                                                        Foreground="{ThemeResource App.TextTertiaryBrush}"
                                                        Text="{x:Bind Title, Mode=OneTime}"
                                                        TextDecorations="Strikethrough"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind CompletedVisibility, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Opacity="0.7"
                                                        Text="{x:Bind Location, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind LocationVisibility, Mode=OneTime}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="4"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.7"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind CalendarName, Mode=OneTime}"
                                                    Visibility="{x:Bind CalendarVisibility, Mode=OneTime}" />
                                            </Grid>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollViewer>

        <ctrl:SkeletonView
            x:Name="Skeleton"
            Grid.Row="1"
            Margin="16"
            Rows="10"
            IsActive="False" />

        <ctrl:EmptyStateView
            x:Name="EmptyStateView"
            Grid.Row="1"
            ActionText="New event"
            Description="Press N or double-click a day in Month view to add something."
            Glyph="&#xE787;"
            Title="Nothing scheduled"
            Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="12,8">
            <Button
                Click="OnLoadEarlierClick"
                Content="Load earlier"
                Visibility="{x:Bind ViewModel.HasEarlier, Mode=OneWay}"
                AutomationProperties.Name="Load earlier agenda items" />
            <Button
                Click="OnLoadLaterClick"
                Content="Load later"
                Visibility="{x:Bind ViewModel.HasLater, Mode=OneWay}"
                AutomationProperties.Name="Load later agenda items" />
        </StackPanel>

    </Grid>

</Page>
