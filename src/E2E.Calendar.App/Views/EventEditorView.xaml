<UserControl
    x:Class="E2E.Calendar.App.Views.EventEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:E2E.Calendar.App.Converters"
    xmlns:core="using:E2E.Calendar.Core.Models;"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Padding="{StaticResource PaddingEditorHeader}" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Event" />
            <Button
                Grid.Column="1"
                Click="OnCloseClick"
                Style="{StaticResource ToolbarButtonStyle}"
                AutomationProperties.Name="Close the event editor"
                ToolTipService.ToolTip="Close">
                <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource PaddingEditorBody}" Spacing="{StaticResource SpaceLG}">

                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Event template"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}"
                    PlaceholderText="Start from a template"
                    SelectionChanged="OnTemplateSelected" />

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="TITLE" />
                    <TextBox
                        AutomationProperties.Name="Event title"
                        PlaceholderText="Add a title"
                        Text="{x:Bind ViewModel.Title, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="All day" />
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="All day"
                            IsOn="{x:Bind ViewModel.IsAllDay, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSM}">
                        <CalendarDatePicker
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Start date"
                            Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />
                        <TimePicker
                            Grid.Column="1"
                            AutomationProperties.Name="Start time"
                            Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSM}">
                        <CalendarDatePicker
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="End date"
                            Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" />
                        <TimePicker
                            Grid.Column="1"
                            AutomationProperties.Name="End time"
                            Time="{x:Bind ViewModel.EndTime, Mode=TwoWay}" />
                    </Grid>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Time zone"
                        ItemsSource="{x:Bind ViewModel.AvailableTimeZones, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.TimeZoneId, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceSM}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="REPEATS" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Repeat frequency"
                        ItemsSource="{x:Bind ViewModel.FrequencyOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.FrequencyIndex, Mode=TwoWay}" />
                    <NumberBox
                        Visibility="{x:Bind ViewModel.IsRepeating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Header="Every"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.IntervalValue, Mode=TwoWay}" />
                    <StackPanel
                        Spacing="{StaticResource SpaceXS}"
                        Visibility="{x:Bind ViewModel.IsWeekly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <ToggleButton Content="M" IsChecked="{x:Bind ViewModel.IsMonday, Mode=TwoWay}" />
                            <ToggleButton Content="T" IsChecked="{x:Bind ViewModel.IsTuesday, Mode=TwoWay}" />
                            <ToggleButton Content="W" IsChecked="{x:Bind ViewModel.IsWednesday, Mode=TwoWay}" />
                            <ToggleButton Content="T" IsChecked="{x:Bind ViewModel.IsThursday, Mode=TwoWay}" />
                            <ToggleButton Content="F" IsChecked="{x:Bind ViewModel.IsFriday, Mode=TwoWay}" />
                            <ToggleButton Content="S" IsChecked="{x:Bind ViewModel.IsSaturday, Mode=TwoWay}" />
                            <ToggleButton Content="S" IsChecked="{x:Bind ViewModel.IsSunday, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Spacing="{StaticResource SpaceXS}"
                        Visibility="{x:Bind ViewModel.IsMonthly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Monthly pattern"
                            ItemsSource="{x:Bind ViewModel.MonthlyPatternOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.MonthlyPatternIndex, Mode=TwoWay}" />
                        <NumberBox
                            Header="Day of the month"
                            Minimum="1"
                            Maximum="31"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.MonthlyDayValue, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel
                        Spacing="{StaticResource SpaceXS}"
                        Visibility="{x:Bind ViewModel.IsYearly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <NumberBox
                            Header="Month"
                            Minimum="1"
                            Maximum="12"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.YearlyMonthValue, Mode=TwoWay}" />
                        <NumberBox
                            Header="Day"
                            Minimum="1"
                            Maximum="31"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.MonthlyDayValue, Mode=TwoWay}" />
                    </StackPanel>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Repeat ends"
                        ItemsSource="{x:Bind ViewModel.RecurrenceEndOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.RecurrenceEndIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsRepeating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <CalendarDatePicker
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Repeat ends on"
                        Date="{x:Bind ViewModel.RepeatEndDate, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsEndOnDate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <NumberBox
                        Header="Number of occurrences"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.OccurrenceCountValue, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsEndAfterCount, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Opacity="{StaticResource TextSecondaryOpacity}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.RecurrenceSummary, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceSM}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="ALERTS" />
                        <Button
                            Grid.Column="1"
                            Click="OnAddAlertClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Add an alert"
                            ToolTipService.ToolTip="Add an alert">
                            <FontIcon FontSize="{StaticResource IconSizeMedium}" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AlertRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlertRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceXS}">
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Alert time"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{x:Bind Options, Mode=OneWay}"
                                        SelectedItem="{x:Bind Option, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OnRemoveAlertClick"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        AutomationProperties.Name="Remove the alert">
                                        <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="LOCATION" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSM}">
                        <TextBox
                            AutomationProperties.Name="Event location"
                            PlaceholderText="Add a location"
                            Text="{x:Bind ViewModel.Location, Mode=TwoWay}" />
                        <HyperlinkButton
                            Grid.Column="1"
                            AutomationProperties.Name="Open the location in a map"
                            Content="Map"
                            NavigateUri="{x:Bind ViewModel.MapSearchUri, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="MEETING" />
                    <TextBox
                        AutomationProperties.Name="Meeting link"
                        PlaceholderText="Paste a Teams, Zoom or Meet link"
                        Text="{x:Bind ViewModel.MeetingUrl, Mode=TwoWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceSM}"
                        Visibility="{x:Bind ViewModel.HasDetectedMeeting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <HyperlinkButton
                            AutomationProperties.Name="Join the meeting"
                            Content="{x:Bind ViewModel.DetectedMeetingLabel, Mode=OneWay}"
                            NavigateUri="{x:Bind ViewModel.DetectedMeetingUri, Mode=OneWay}" />
                        <Button
                            Click="OnClearMeetingClick"
                            Content="Clear"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    </StackPanel>
                    <Button
                        Click="OnDetectMeetingClick"
                        Content="Detect meeting link"
                        Style="{StaticResource ToolbarButtonStyle}" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="NOTES" />
                    <TextBox
                        AcceptsReturn="True"
                        AutomationProperties.Name="Event notes"
                        Height="{StaticResource NotesBoxHeight}"
                        PlaceholderText="Add notes"
                        Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="CALENDAR" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Calendar"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.CalendarOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCalendar, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSS}">
                        <Button
                            Click="OnPreviousColorClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Previous colour">
                            <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE72B;" />
                        </Button>
                        <Button
                            Click="OnNextColorClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Next colour">
                            <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE72A;" />
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ColorLabel, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SpaceXS}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="LINK" />
                    <TextBox
                        AutomationProperties.Name="Event link"
                        PlaceholderText="https://"
                        Text="{x:Bind ViewModel.Url, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="{StaticResource PaddingEditorHeader}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            ColumnDefinitions="*,Auto,Auto">
            <Button
                Grid.Column="1"
                Click="OnDeleteClick"
                Content="Delete"
                AutomationProperties.Name="Delete the event" />
            <Button
                Grid.Column="2"
                Margin="{StaticResource MarginStartMedium}"
                Click="OnSaveClick"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="Save the event" />
        </Grid>

    </Grid>

</UserControl>
