<UserControl
    x:Class="E2E.Calendar.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="{ThemeResource App.CardBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Section list  -->
        <Grid Grid.Column="0" Padding="12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="12,0,0,8"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                AutomationProperties.Name="Settings"
                Text="Settings" />

            <ListView
                x:Name="SectionList"
                Grid.Row="1"
                Background="{ThemeResource App.TransparentBrush}"
                SelectionChanged="OnSectionSelectionChanged"
                SelectionMode="Single"
                AutomationProperties.Name="Settings sections">
                <ListView.Resources>
                    <!-- Selected row is a soft Accent pill, not the default grey highlight. -->
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentSoft" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentSoft" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentSoft" />
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="App.HoverBrush" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMD}">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="{StaticResource IconSizeLarge}"
                                Glyph="{Binding Glyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsCardTitleStyle}"
                                Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!--  Section content  -->
        <ScrollViewer
            x:Name="ContentScroll"
            Grid.Column="1"
            Padding="24,16,24,24"
            AutomationProperties.Name="Settings content"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="{StaticResource SpaceLG}">

                <!--  General  -->
                <StackPanel x:Name="SectionGeneral" Spacing="{StaticResource SpaceMD}">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="General" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Clock format" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="How times are shown across the calendar." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.ClockFormatLabels, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.ClockFormatIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Clock format" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Week starts on" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="First day of the week in the mini calendar and week view." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.WeekStartLabels, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.WeekStartIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Week start day" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Show weekends" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Include Saturday and Sunday in the week view." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.ShowWeekends, Mode=TwoWay}"
                                AutomationProperties.Name="Show weekends" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Show week numbers" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Display ISO week numbers beside the date." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.ShowWeekNumbers, Mode=TwoWay}"
                                AutomationProperties.Name="Show week numbers" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Start at login" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Launch E2E Calendar minimized to the tray when you sign in, so reminders keep firing."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="{x:Bind ViewModel.StartAtLoginNote, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasStartAtLoginNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Click="OnOpenStartupSettingsClick"
                                    Content="Open startup settings"
                                    Visibility="{x:Bind ViewModel.CanOpenStartupSettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Open Windows startup settings" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsStartAtLoginEditable, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.StartAtLogin, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.IsStartAtLoginSupported, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Start at login" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceSM}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Secondary time zone" />
                                    <TextBlock
                                        Style="{StaticResource SettingsCardDescriptionStyle}"
                                        Text="Add a second time zone column to the time grid, converted from each event's stored UTC instant." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsOn="{x:Bind ViewModel.ShowSecondaryTimeZone, Mode=TwoWay}"
                                    AutomationProperties.Name="Show secondary time zone" />
                            </Grid>
                            <!-- The zone picker only exists while the column is switched on. -->
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.TimeZoneLabels, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.SecondaryTimeZoneIndex, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.ShowSecondaryTimeZone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Secondary time zone" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!--  Accounts  -->
                <StackPanel x:Name="SectionAccounts" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Accounts" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource IconSizeLarge}"
                                            Glyph="&#xE77B;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="{Binding DisplayName}" />
                                            <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Content="Remove"
                                            Tag="{Binding Id}"
                                            Click="OnRemoveAccountClick"
                                            AutomationProperties.Name="Remove account" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceSM}">
                            <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Add an account" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                Text="Connect Google, Microsoft or CalDAV. The free plan includes one account; premium unlocks unlimited accounts." />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                Text="{x:Bind ViewModel.AccountStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                                <Button
                                    Content="Add Google account"
                                    Command="{x:Bind ViewModel.AddGoogleAccountCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAddAccount, Mode=OneWay}"
                                    AutomationProperties.Name="Add Google account" />
                                <Button
                                    Content="Add Microsoft account"
                                    Command="{x:Bind ViewModel.AddMicrosoftAccountCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAddAccount, Mode=OneWay}"
                                    AutomationProperties.Name="Add Microsoft account" />
                                <Button
                                    Content="Add CalDAV account"
                                    Command="{x:Bind ViewModel.AddCalDavAccountCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAddAccount, Mode=OneWay}"
                                    AutomationProperties.Name="Add CalDAV account" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Calendars  -->
                <StackPanel x:Name="SectionCalendars" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Calendars" />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                        <Button
                            Content="Create calendar"
                            Click="OnCreateCalendarClick"
                            AutomationProperties.Name="Create calendar" />
                        <Button
                            Content="Add subscription"
                            Click="OnAddSubscriptionClick"
                            AutomationProperties.Name="Add calendar subscription" />
                    </StackPanel>

                    <Border x:Name="BirthdayImportCard" Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Show birthdays" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Import read-only birthdays from your connected accounts. Permission is requested only when enabled." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.ShowBirthdays, Mode=TwoWay}"
                                Toggled="OnBirthdaysToggled"
                                AutomationProperties.Name="Show birthdays" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Calendars, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                                        <Ellipse
                                            Width="{StaticResource CalendarSwatchSize}"
                                            Height="{StaticResource CalendarSwatchSize}"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceXS}">
                                            <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="{Binding Name}" />
                                            <TextBlock
                                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                                Text="{Binding Detail}"
                                                Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                                            <Button
                                                Content="Color"
                                                Tag="{Binding Id}"
                                                Click="OnCalendarColorClick"
                                                AutomationProperties.Name="Change calendar color" />
                                            <Button
                                                Content="Delete"
                                                Tag="{Binding Id}"
                                                Click="OnDeleteCalendarClick"
                                                Visibility="{Binding IsNotSubscription, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="Delete calendar" />
                                            <Button
                                                Content="Remove"
                                                Tag="{Binding Id}"
                                                Click="OnDeleteCalendarClick"
                                                Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="Remove calendar subscription" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Notifications  -->
                <StackPanel x:Name="SectionNotifications" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Notifications" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Reminder notifications" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Reminders appear as Windows notifications. Sound and delivery are controlled in Windows settings."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnWindowsNotificationSettingsClick"
                                Content="Open Windows settings"
                                AutomationProperties.Name="Open Windows notification settings" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Default snooze" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Pre-selected snooze length on reminder notifications."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.SnoozeLabels, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.DefaultSnoozeIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Default snooze length" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Daily digest" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="One summary each morning with today's events and reminders."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpaceSM}">
                                <TimePicker
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Daily digest time"
                                    IsEnabled="{x:Bind ViewModel.DailyDigestEnabled, Mode=OneWay}"
                                    Time="{x:Bind ViewModel.DailyDigestTime, Mode=TwoWay}" />
                                <ToggleSwitch
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Daily digest"
                                    IsOn="{x:Bind ViewModel.DailyDigestEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock
                                    Style="{StaticResource SettingsCardTitleStyle}"
                                    Text="Critical reminders can break through Do Not Disturb"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Critical reminders use an urgent notification that is shown while focus assist is on."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Critical reminders can break through Do Not Disturb"
                                IsOn="{x:Bind ViewModel.CriticalBreaksThroughDoNotDisturb, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Persistent alarms repeat every" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="How often a persistent reminder re-fires until it is marked done."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.RepeatIntervalLabels, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.PersistentRepeatIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Persistent alarm repeat interval" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  Appearance  -->
                <StackPanel x:Name="SectionAppearance" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Appearance" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Theme" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Choose light, dark, or follow Windows." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind ViewModel.ThemeLabels, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Theme" />
                        </Grid>
                    </Border>



                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Hour height" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="How tall each hour is in the day and week views." />
                            </StackPanel>
                            <Slider
                                Grid.Column="1"
                                Width="180"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Hour height"
                                Maximum="{x:Bind ViewModel.MaxHourHeight, Mode=OneTime}"
                                Minimum="{x:Bind ViewModel.MinHourHeight, Mode=OneTime}"
                                StepFrequency="4"
                                Value="{x:Bind ViewModel.HourHeight, Mode=TwoWay}" />
                        </Grid>
                    </Border>


                </StackPanel>

                <!--  Shortcuts  -->
                <StackPanel x:Name="SectionShortcuts" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Shortcuts" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel AutomationProperties.Name="Keyboard shortcuts" Spacing="{StaticResource SpaceXS}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="New event" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="N" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="New reminder" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="R" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Go to today" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="T" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Quick add" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="Win + Alt + C" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Search" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="Ctrl + F" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Command palette" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="Ctrl + K" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Day / Week / Month / Agenda" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="D / W / M / A" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Previous / next period" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="Arrow keys" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Undo delete" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsCardDescriptionStyle}" Text="Ctrl + Z" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Premium  -->
                <StackPanel x:Name="SectionPremium" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Premium" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Your plan" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="{x:Bind ViewModel.PremiumStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="{x:Bind ViewModel.PremiumNote, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceXS}">
                                <Button
                                    AutomationProperties.Name="Upgrade"
                                    Command="{x:Bind ViewModel.ShowPaywallCommand}"
                                    Content="Upgrade" />
                                <Button
                                    AutomationProperties.Name="Restore purchases"
                                    Command="{x:Bind ViewModel.RestorePurchasesCommand}"
                                    Content="Restore purchases" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  Privacy & data  -->
                <StackPanel x:Name="SectionPrivacy" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Privacy &amp; data" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceXS}">
                            <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Your data stays on this device" />
                            <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind ViewModel.DatabaseSummary, Mode=OneTime}" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                Text="No account required. Tokens are kept in Windows Credential Manager." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Export all events" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Save every event from all calendars as a single iCalendar (.ics) file." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Export all events"
                                Content="Export .ics"
                                Click="OnExportEventsClick" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Delete all data" />
                                <TextBlock
                                    Style="{StaticResource SettingsCardDescriptionStyle}"
                                    Text="Remove every calendar, event, reminder and setting from this device." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Delete all data"
                                Content="Delete…"
                                Click="OnDeleteAllDataClick" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  Developer  -->
                <StackPanel x:Name="SectionDeveloper" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="Developer" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceXS}">
                            <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Demo data" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                Text="Sample calendars and events are only loaded when E2E_DEMO=1." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  About  -->
                <StackPanel x:Name="SectionAbout" Spacing="{StaticResource SpaceMD}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" Text="About" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="{StaticResource SpaceXS}">
                            <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="E2E Calendar" />
                            <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind ViewModel.AppVersion, Mode=OneTime}" />
                            <TextBlock
                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                Text="Offline-first calendar, reminders and tasks for Windows." />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
