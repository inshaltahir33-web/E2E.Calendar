<UserControl
    x:Class="E2E.Calendar.App.Views.QuickAddViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:E2E.Calendar.App.Converters"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid
        x:Name="RootGrid"
        Padding="{StaticResource InsetLG}"
        Background="{ThemeResource App.CardElevatedBrush}"
        CornerRadius="{StaticResource RadiusCard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DragRegion"
            Height="28"
            Background="Transparent"
            AutomationProperties.Name="Move the quick add window">
            <TextBlock
                Margin="{StaticResource MarginStartSmall}"
                VerticalAlignment="Center"
                Opacity="{StaticResource TextSecondaryOpacity}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Quick Add" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceSM}">

            <TextBox
                x:Name="InputBox"
                MinHeight="40"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Quick add input"
                PlaceholderText="＋ Lunch with Ali tomorrow 1pm at Kohinoor…"
                Text="{x:Bind ViewModel.Input, Mode=TwoWay}"
                TextChanged="OnInputTextChanged"
                KeyDown="OnInputKeyDown" />

            <Border Style="{StaticResource EditorCardStyle}">
                <StackPanel Spacing="{StaticResource SpaceXS}">

                    <Grid ColumnDefinitions="Auto,*">
                        <FontIcon
                            x:Name="KindIcon"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSizeMedium}"
                            Glyph="&#xE787;" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="{StaticResource MarginStartMedium}"
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.TitlePreview, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSizeSmall}"
                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.WhenIcon, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="{StaticResource MarginStartMedium}"
                            VerticalAlignment="Center"
                            Opacity="{StaticResource TextSecondaryOpacity}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.WhenPreview, Mode=OneWay}" />
                    </Grid>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        Visibility="{x:Bind ViewModel.HasLocation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSizeSmall}"
                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.WhereIcon, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="{StaticResource MarginStartMedium}"
                            VerticalAlignment="Center"
                            Opacity="{StaticResource TextSecondaryOpacity}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.WherePreview, Mode=OneWay}" />
                    </Grid>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        Visibility="{x:Bind ViewModel.HasAlert, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource IconSizeSmall}"
                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.AlertIcon, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="{StaticResource MarginStartMedium}"
                            VerticalAlignment="Center"
                            Opacity="{StaticResource TextSecondaryOpacity}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.AlertPreview, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                        <Button
                            Click="OnCalendarChipClick"
                            Style="{StaticResource SubtleHoverStyle}"
                            ToolTipService.ToolTip="Tab cycles calendars"
                            AutomationProperties.Name="Choose the calendar">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSS}">
                                <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE8EC;" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CalendarPreview, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpaceXSS}"
                            Visibility="{x:Bind ViewModel.IsPriority, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE7C1;" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PriorityPreview, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>

        <Grid
            Grid.Row="2"
            Margin="0,12,0,0"
            ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Opacity="{StaticResource TextSecondaryOpacity}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.KindLabel, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                Click="OnCancelClick"
                Content="Esc Cancel"
                AutomationProperties.Name="Cancel quick add" />
            <Button
                Grid.Column="3"
                Margin="{StaticResource MarginStartMedium}"
                Click="OnSaveClick"
                Content="Enter ✓"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="Save quick add" />
        </Grid>

    </Grid>

</UserControl>
