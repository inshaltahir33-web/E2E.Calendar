<UserControl
    x:Class="E2E.Calendar.App.Views.QuickAddViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <!-- Centred 560px card: one large input, parsed preview chips, Enter hint on the right. -->
    <Border
        x:Name="RootGrid"
        Padding="{StaticResource InsetLG}"
        Background="{ThemeResource App.CardElevatedBrush}"
        BorderBrush="{ThemeResource App.DividerBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusCard}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <TextBox
                x:Name="InputBox"
                MinHeight="44"
                Padding="12,8"
                VerticalContentAlignment="Center"
                Background="{ThemeResource App.TransparentBrush}"
                BorderThickness="0"
                FontSize="{StaticResource FontSizeSubtitle}"
                FontWeight="SemiBold"
                PlaceholderText="＋ Lunch with Ali tomorrow 1pm at Kohinoor…"
                AutomationProperties.Name="Quick add input"
                Text="{x:Bind ViewModel.Input, Mode=TwoWay}"
                TextChanged="OnInputTextChanged"
                KeyDown="OnInputKeyDown" />

            <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="{StaticResource SpaceXSS}">

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSS}">
                    <Border
                        Padding="8,3"
                        Background="{ThemeResource App.CardBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}">
                        <TextBlock
                            MaxWidth="200"
                            FontSize="{StaticResource FontSizeCaption}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource App.TextPrimaryBrush}"
                            Text="{x:Bind ViewModel.TitlePreview, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Border
                        Padding="8,3"
                        Background="{ThemeResource App.AccentSubtleBrush}"
                        CornerRadius="{StaticResource RadiusPill}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <FontIcon
                                x:Name="KindIcon"
                                FontSize="{StaticResource IconSizeSmall}"
                                Foreground="{ThemeResource App.AccentBrush}"
                                Glyph="&#xE787;" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource App.AccentBrush}"
                                Text="{x:Bind ViewModel.KindLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8,3"
                        Background="{ThemeResource App.CardBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <FontIcon
                                FontSize="{StaticResource IconSizeSmall}"
                                Foreground="{ThemeResource App.TextSecondaryBrush}"
                                Glyph="{x:Bind ViewModel.WhenIcon, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="320"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{ThemeResource App.TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.WhenPreview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSS}">

                    <Border
                        Padding="8,3"
                        Background="{ThemeResource App.CardBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Visibility="{x:Bind ViewModel.HasLocation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <FontIcon
                                FontSize="{StaticResource IconSizeSmall}"
                                Foreground="{ThemeResource App.TextSecondaryBrush}"
                                Glyph="{x:Bind ViewModel.WhereIcon, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="160"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{ThemeResource App.TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.WherePreview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8,3"
                        Background="{ThemeResource App.CardBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Visibility="{x:Bind ViewModel.HasAlert, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <FontIcon
                                FontSize="{StaticResource IconSizeSmall}"
                                Foreground="{ThemeResource App.TextSecondaryBrush}"
                                Glyph="{x:Bind ViewModel.AlertIcon, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="160"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{ThemeResource App.TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.AlertPreview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Button
                        Padding="8,3"
                        Background="{ThemeResource App.CardBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Click="OnCalendarChipClick"
                        AutomationProperties.Name="Choose the calendar"
                        ToolTipService.ToolTip="Tab cycles calendars">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE8EC;" />
                            <TextBlock
                                MaxWidth="140"
                                FontSize="{StaticResource FontSizeCaption}"
                                Text="{x:Bind ViewModel.CalendarPreview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Border
                        Padding="8,3"
                        Background="{ThemeResource App.CardBackgroundBrush}"
                        BorderBrush="{ThemeResource App.DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}"
                        Visibility="{x:Bind ViewModel.IsPriority, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}">
                            <FontIcon FontSize="{StaticResource IconSizeSmall}" Glyph="&#xE7C1;" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeCaption}"
                                Text="{x:Bind ViewModel.PriorityPreview, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>

            <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSM}">
                <Button
                    Click="OnCancelClick"
                    Content="Cancel"
                    Style="{StaticResource SubtleHoverStyle}"
                    AutomationProperties.Name="Cancel quick add" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceSM}"
                    VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{ThemeResource App.TextSecondaryBrush}"
                        Text="Enter ↵" />
                    <Button
                        Click="OnSaveClick"
                        Content="Save"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Save quick add" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>

</UserControl>
