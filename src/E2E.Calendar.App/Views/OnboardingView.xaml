<UserControl
    x:Class="E2E.Calendar.App.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Width="480"
        MinHeight="320"
        RowSpacing="{StaticResource SpaceLG}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Step 1: Connect account  -->
        <StackPanel
            x:Name="StepConnect"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource SpaceMD}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeHero}"
                Glyph="&#xE77B;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Your calendars, in one place"
                TextAlignment="Center" />
            <TextBlock
                MaxWidth="380"
                HorizontalAlignment="Center"
                Style="{StaticResource SettingsCardDescriptionStyle}"
                Text="E2E Calendar works fully offline. You can add Google, Microsoft or CalDAV accounts later from Settings."
                TextAlignment="Center" />
            <TextBlock
                MaxWidth="380"
                HorizontalAlignment="Center"
                Style="{StaticResource SettingsCardDescriptionStyle}"
                Text="No account is required to get started."
                TextAlignment="Center" />
        </StackPanel>

        <!--  Step 2: Theme  -->
        <StackPanel
            x:Name="StepTheme"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource SpaceMD}"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeHero}"
                Glyph="&#xE790;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Pick a look"
                TextAlignment="Center" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceMD}">
                <RadioButton AutomationProperties.Name="Use the system theme" Content="Use system setting" IsChecked="True" Tag="System" />
                <RadioButton AutomationProperties.Name="Use the light theme" Content="Light" Tag="Light" />
                <RadioButton AutomationProperties.Name="Use the dark theme" Content="Dark" Tag="Dark" />
            </StackPanel>
        </StackPanel>

        <!--  Step 3: Notifications  -->
        <StackPanel
            x:Name="StepNotifications"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource SpaceMD}"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeHero}"
                Glyph="&#xEA8F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Never miss a reminder"
                TextAlignment="Center" />
            <TextBlock
                MaxWidth="380"
                HorizontalAlignment="Center"
                Style="{StaticResource SettingsCardDescriptionStyle}"
                Text="Reminders and alarms appear as Windows notifications, even when the app is closed."
                TextAlignment="Center" />
            <CheckBox
                x:Name="EnableNotifications"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Enable reminder notifications"
                Content="Turn on reminder notifications"
                IsChecked="True" />
        </StackPanel>

        <!--  Footer  -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button
                Grid.Column="0"
                Click="OnSkipClick"
                AutomationProperties.Name="Skip onboarding"
                Content="Skip" />
            <TextBlock
                x:Name="StepIndicator"
                Grid.Column="2"
                Margin="{StaticResource MarginStartLarge}"
                VerticalAlignment="Center"
                Style="{StaticResource SettingsCardDescriptionStyle}"
                Text="1 of 3" />
            <Button
                x:Name="NextButton"
                Grid.Column="3"
                Margin="{StaticResource MarginStartMedium}"
                Click="OnNextClick"
                AutomationProperties.Name="Continue"
                Content="Continue"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
