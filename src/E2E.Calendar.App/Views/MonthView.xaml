<Page
    x:Class="E2E.Calendar.App.Views.MonthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="Transparent" Loaded="OnLoaded">

        <muxc:ItemsRepeater x:Name="DaysRepeater" ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
            <muxc:ItemsRepeater.Layout>
                <muxc:UniformGridLayout
                    MaximumRowsOrColumns="7"
                    MinItemHeight="92"
                    MinItemWidth="110"
                    Orientation="Horizontal" />
            </muxc:ItemsRepeater.Layout>
            <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthDay">
                    <Grid Padding="4" RowDefinitions="Auto,Auto,*">

                        <Grid ColumnDefinitions="Auto,*" Height="20">
                            <Button
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Open the day view"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnDayNumberClicked"
                                Content="{x:Bind DayNumber, Mode=OneWay}"
                                Padding="4,0,4,0" />
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Border
                                    Width="5"
                                    Height="5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Opacity="{x:Bind Heat1, Mode=OneWay}" />
                                <Border
                                    Width="5"
                                    Height="5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Opacity="{x:Bind Heat2, Mode=OneWay}" />
                                <Border
                                    Width="5"
                                    Height="5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Opacity="{x:Bind Heat3, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Chips, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonthChip">
                                    <Border
                                        Margin="0,1,0,1"
                                        Padding="4,1,4,1"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border
                                                Width="3"
                                                Background="{x:Bind Color, Mode=OneWay, Converter={StaticResource ColorToBrush}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnMoreClicked"
                            Visibility="{x:Bind MoreVisibility, Mode=OneWay}"
                            AutomationProperties.Name="Show all events of the day">
                            <TextBlock FontSize="11" Text="{x:Bind MoreLabel, Mode=OneWay}" />
                        </Button>

                    </Grid>
                </DataTemplate>
            </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>

    </Grid>

</Page>
