<Page
    x:Class="E2E.Calendar.App.Views.MonthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="{ThemeResource App.TransparentBrush}" RowDefinitions="Auto,*">

        <!-- The month lives inside one rounded card. The grid lines are drawn by the cells
             with 1px GridLine borders; outer cell edges are dropped so the card border is
             the only outer line. -->
        <Border
            Grid.RowSpan="2"
            Background="{ThemeResource App.CardBackgroundBrush}"
            BorderBrush="{ThemeResource App.DividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="WeekdayHeaderHost" Grid.Row="0" />
                <Grid x:Name="MonthHost" Grid.Row="1" />
            </Grid>
        </Border>

        <ctrl:SkeletonView
            x:Name="Skeleton"
            Grid.Row="1"
            Margin="16"
            Rows="8"
            IsActive="False" />

        <ctrl:EmptyStateView
            x:Name="EmptyStateView"
            Grid.Row="1"
            ActionText="New event"
            Description="Double-click a day or press N to add something to this month."
            Glyph="&#xE787;"
            Title="Nothing scheduled this month"
            Visibility="Collapsed" />

    </Grid>

</Page>
