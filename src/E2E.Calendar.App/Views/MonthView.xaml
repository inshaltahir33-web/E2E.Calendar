<Page
    x:Class="E2E.Calendar.App.Views.MonthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="Transparent" RowDefinitions="Auto,*">

        <Grid x:Name="WeekdayHeaderHost" Grid.Row="0" />

        <Grid x:Name="MonthHost" Grid.Row="1" />

        <TextBlock
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.7"
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="Nothing scheduled this month."
            Visibility="Collapsed" />

    </Grid>

</Page>
