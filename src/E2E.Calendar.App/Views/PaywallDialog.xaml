<ContentDialog
    x:Class="E2E.Calendar.App.Views.PaywallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:E2E.Calendar.App.ViewModels"
    AutomationProperties.Name="Premium plans"
    CloseButtonText="Not now"
    DefaultButton="Close"
    Title="Calendar Pro Premium">

    <StackPanel Spacing="{StaticResource SpaceMD}">
        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
        <TextBlock
            Style="{StaticResource SettingsCardDescriptionStyle}"
            Text="Unlimited accounts, persistent reminders, calendar sets, year view, all templates and free-slot search."
            TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaywallPlan">
                    <Border Margin="0,0,0,8" Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMD}">
                            <StackPanel Spacing="{StaticResource SpaceXS}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSM}">
                                    <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="{x:Bind Title}" />
                                    <Border
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentSoft}"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        Visibility="{x:Bind BadgeVisibility}">
                                        <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind Badge}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind PriceText}" />
                                <TextBlock Style="{StaticResource SettingsCardDescriptionStyle}" Text="{x:Bind Detail}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                MinWidth="104"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind BuyAutomationName}"
                                Click="OnBuyClick"
                                Content="{x:Bind BuyLabel}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind BuyVisibility}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsCardDescriptionStyle}"
                                Text="Purchased"
                                Visibility="{x:Bind OwnedVisibility}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Style="{StaticResource SettingsCardDescriptionStyle}"
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            TextWrapping="Wrap" />

        <Button
            HorizontalAlignment="Left"
            AutomationProperties.Name="Restore purchases"
            Click="OnRestoreClick"
            Content="Restore purchases" />
    </StackPanel>
</ContentDialog>
