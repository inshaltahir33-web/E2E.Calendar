<ContentDialog
    x:Class="E2E.Calendar.App.Views.PickPlaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:services="using:E2E.Calendar.App.Services"
    Title="Pick a place"
    PrimaryButtonText="Choose"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8" Width="520">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search for a place"
                PlaceholderText="Search for a place"
                KeyDown="OnSearchKeyDown" />
            <Button
                Grid.Column="1"
                Click="OnSearchClick"
                Content="Search"
                AutomationProperties.Name="Search" />
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Foreground="{ThemeResource App.TextSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ListView
            x:Name="ResultsList"
            Grid.Row="2"
            MaxHeight="180"
            SelectionChanged="OnResultSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:PlaceSearchResult">
                    <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:WebView2
            x:Name="PreviewMap"
            Grid.Row="3"
            Height="220" />

        <TextBlock
            Grid.Row="4"
            FontSize="10"
            Foreground="{ThemeResource App.TextSecondaryBrush}"
            Text="© OpenStreetMap contributors" />
    </Grid>
</ContentDialog>