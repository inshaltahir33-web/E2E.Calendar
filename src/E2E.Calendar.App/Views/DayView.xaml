<Page
    x:Class="E2E.Calendar.App.Views.DayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="{ThemeResource App.TransparentBrush}" Loaded="OnLoaded" RowDefinitions="Auto,*">
        <Border Padding="12,6" Background="{ThemeResource App.CardBackgroundBrush}">
            <TextBlock Text="{x:Bind ViewModel.WeatherText, Mode=OneWay}" AutomationProperties.Name="Local weather" />
        </Border>

        <ctrl:TimeGrid
            Grid.Row="1"
            x:Name="TimeGrid"
            Days="{x:Bind ViewModel.Days, Mode=OneWay}"
            Items="{x:Bind ViewModel.Items, Mode=OneWay}"
            Now="{x:Bind ViewModel.Now, Mode=OneWay}"
            ClockFormat="{x:Bind ViewModel.ClockFormat, Mode=OneWay}"
            HourHeight="{x:Bind ViewModel.HourHeight, Mode=OneWay}"
            SecondaryTimeZoneId="{x:Bind ViewModel.SecondaryTimeZoneId, Mode=OneWay}"
            ShowSecondaryTimeZone="{x:Bind ViewModel.ShowSecondaryTimeZone, Mode=OneWay}" />

        <ctrl:SkeletonView
            x:Name="Skeleton"
            Margin="16"
            Rows="10"
            IsActive="False" />

    </Grid>

</Page>
