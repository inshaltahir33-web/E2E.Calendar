<Page
    x:Class="E2E.Calendar.App.Views.TodoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="24,16,24,8"
        Background="{ThemeResource App.TransparentBrush}"
        Loaded="OnLoaded"
        RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock
            x:Name="HeadingText"
            Grid.Row="0"
            FontSize="{StaticResource FontSizePageTitle}"
            FontWeight="SemiBold"
            Foreground="{ThemeResource App.TextPrimaryBrush}"
            AutomationProperties.Name="List name" />

        <!-- One rounded input with the Add button inside it. -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,4"
            Background="{ThemeResource App.CardBackgroundBrush}"
            BorderBrush="{ThemeResource App.DividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusInput}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox
                    x:Name="AddBox"
                    Padding="12,0"
                    Background="{ThemeResource App.TransparentBrush}"
                    BorderThickness="0"
                    PlaceholderText="Add a task or reminder, then press Enter"
                    KeyDown="OnAddKeyDown"
                    AutomationProperties.Name="New item title" />
                <Button
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource App.TransparentBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource App.AccentBrush}"
                    Content="Add"
                    Click="OnAddClick"
                    AutomationProperties.Name="Add item" />
            </Grid>
        </Border>

        <TextBlock
            x:Name="HintText"
            Grid.Row="2"
            Margin="0,0,0,8"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource App.TextSecondaryBrush}"
            TextWrapping="Wrap" />

        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="RowsHost" />
                <TextBlock
                    x:Name="EmptyText"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource App.TextTertiaryBrush}"
                    Text="Nothing here yet. Add something above."
                    Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

    </Grid>

</Page>
