<Window
    x:Class="E2E.Calendar.App.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:E2E.Calendar.App.ViewModels"
    Title="E2E Calendar">

    <Grid Padding="16,14,16,12" Background="{ThemeResource App.CardBackgroundBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource App.TextPrimaryBrush}"
                    Text="Agenda" />
                <TextBlock
                    x:Name="DateText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource App.TextSecondaryBrush}" />
            </Grid>

            <Border
                Grid.Row="1"
                Padding="12"
                Background="{ThemeResource App.CardElevatedBrush}"
                CornerRadius="{StaticResource RadiusCard}">
                <StackPanel Spacing="3">
                    <TextBlock
                        FontSize="11"
                        CharacterSpacing="80"
                        Foreground="{ThemeResource App.TextSecondaryBrush}"
                        Text="NEXT UP" />
                    <TextBlock
                        x:Name="NextEventTitle"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource App.TextPrimaryBrush}"
                        Text="No upcoming events"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="NextEventDetail"
                        FontSize="12"
                        Foreground="{ThemeResource App.TextSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock
                    FontSize="11"
                    CharacterSpacing="80"
                    Foreground="{ThemeResource App.TextSecondaryBrush}"
                    Text="TODAY" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="TodayList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrayAgendaItem">
                                    <Grid Margin="0,3" ColumnDefinitions="52,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                                            Text="{x:Bind TimeText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource App.TextPrimaryBrush}"
                                            Opacity="{x:Bind TitleOpacity}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            x:Name="EmptyToday"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource App.TextSecondaryBrush}"
                            Text="Nothing scheduled today."
                            Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid
                Grid.Row="3"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
                <Button
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="New event"
                    Click="OnNewEventClick"
                    Content="New event"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="New reminder"
                    Click="OnNewReminderClick"
                    Content="New reminder"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Open calendar"
                    Click="OnOpenClick"
                    Content="Open"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
