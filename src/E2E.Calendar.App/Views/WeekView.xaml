<Page
    x:Class="E2E.Calendar.App.Views.WeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="Transparent" Loaded="OnLoaded" RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Margin="12,8" ColumnDefinitions="Auto,*">
            <ToggleButton
                VerticalAlignment="Center"
                AutomationProperties.Name="Show weekends"
                Content="Weekends"
                IsChecked="{x:Bind ViewModel.ShowWeekends, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.State.PeriodLabel, Mode=OneWay}" />
        </Grid>

        <ctrl:TimeGrid
            x:Name="TimeGrid"
            Grid.Row="1"
            Days="{x:Bind ViewModel.Days, Mode=OneWay}"
            Items="{x:Bind ViewModel.Items, Mode=OneWay}" />

    </Grid>

</Page>
