<Page
    x:Class="E2E.Calendar.App.Views.WeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:E2E.Calendar.App.Controls"
    xmlns:vm="using:E2E.Calendar.App.ViewModels">

    <Grid Background="{ThemeResource App.TransparentBrush}" Loaded="OnLoaded">

        <!-- The weather line is gone: the TimeGrid header renders it as a compact chip
             (icon + temperature + condition) at its top-right corner. -->
        <ctrl:TimeGrid
            x:Name="TimeGrid"
            Days="{x:Bind ViewModel.Days, Mode=OneWay}"
            Items="{x:Bind ViewModel.Items, Mode=OneWay}"
            Now="{x:Bind ViewModel.Now, Mode=OneWay}"
            WeekStart="{x:Bind ViewModel.WeekStart, Mode=OneWay}"
            ClockFormat="{x:Bind ViewModel.ClockFormat, Mode=OneWay}"
            HourHeight="{x:Bind ViewModel.HourHeight, Mode=OneWay}"
            ShowSecondaryTimeZone="{x:Bind ViewModel.ShowSecondaryTimeZone, Mode=OneWay}"
            SecondaryTimeZoneId="{x:Bind ViewModel.SecondaryTimeZoneId, Mode=OneWay}"
            WeatherText="{x:Bind ViewModel.WeatherText, Mode=OneWay}" />

        <ctrl:SkeletonView
            x:Name="Skeleton"
            Margin="16"
            Rows="10"
            IsActive="False" />

    </Grid>

</Page>
